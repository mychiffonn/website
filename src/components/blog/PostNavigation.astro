---
import type { Post } from "@/lib/blog/types"
import Button from "@/components/base/Button.astro"
import Icon from "@/components/base/Icon.astro"

interface Props {
  prevPost?: Post | null
  nextPost?: Post | null
  parentPost?: Post | null
}

const { prevPost, nextPost, parentPost } = Astro.props
const isSubpost = !!parentPost
---

<nav class="post-navigation" data-subpost={isSubpost ? "true" : "false"}>
  <Button
    href={nextPost ? `/${nextPost.collection}/${nextPost.id}#post-title` : undefined}
    variant="outline"
    aria-disabled={!nextPost}
  >
    <post-navigation-content data-direction="previous">
      <post-navigation-icon><Icon name="arrow-left" /></post-navigation-icon>
      <post-navigation-label>
        <span>
          {isSubpost ? "Previous Subpost" : "Previous Post"}
        </span>
        <strong>
          {nextPost?.data.title || (isSubpost ? "No older subpost" : "You're at the oldest post!")}
        </strong>
      </post-navigation-label>
    </post-navigation-content>
  </Button>

  {isSubpost && (
      <Button
        href={parentPost ? `/${parentPost.collection}/${parentPost.id}#post-title` : undefined}
        variant="outline"
        aria-disabled={!parentPost}
      >
        <post-navigation-content data-direction="parent">
          <post-navigation-icon><Icon name="arrow-left-up" /></post-navigation-icon>
          <post-navigation-label>
            <span>Parent Post</span>
            <strong>
              {parentPost?.data.title || "No parent post"}
            </strong>
          </post-navigation-label>
        </post-navigation-content>
      </Button>
    )}

  <Button
    href={prevPost ? `/${prevPost.collection}/${prevPost.id}#post-title` : undefined}
    variant="outline"
    aria-disabled={!prevPost}
  >
    <post-navigation-content data-direction="next">
      <post-navigation-label>
        <span>
          {isSubpost ? "Next Subpost" : "Next Post"}
        </span>
        <strong>
          {prevPost?.data.title || (isSubpost ? "No newer subpost" : "You're at the newest post!")}
        </strong>
      </post-navigation-label>
      <post-navigation-icon><Icon name="arrow-right" /></post-navigation-icon>
    </post-navigation-content>
  </Button>
</nav>

<style>
  .post-navigation {
    --button-border-radius: var(--radius-lg);
    --button-inline-size: 100%;
    --button-min-block-size: 4rem;

    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);
  }

  .post-navigation[data-subpost="true"] {
    @media (width >= 40rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .post-navigation[data-subpost="false"] {
    @media (width >= 40rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  post-navigation-content {
    display: flex;
    inline-size: 100%;
    align-items: center;
    gap: var(--space-2xs);
  }

  post-navigation-content[data-direction="previous"] {
    justify-content: flex-start;
  }

  post-navigation-content[data-direction="parent"] {
    justify-content: center;
  }

  post-navigation-content[data-direction="next"] {
    justify-content: flex-end;
  }

  post-navigation-label {
    display: flex;
    min-inline-size: 0;
    flex-direction: column;
    overflow: hidden;
    text-wrap: pretty;
  }

  post-navigation-content[data-direction="previous"] post-navigation-label {
    align-items: flex-start;
    text-align: start;
  }

  post-navigation-content[data-direction="parent"] post-navigation-label {
    align-items: center;
    text-align: center;
  }

  post-navigation-content[data-direction="next"] post-navigation-label {
    align-items: flex-end;
    text-align: end;
  }

  post-navigation-label span {
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  post-navigation-label strong {
    display: -webkit-box;
    inline-size: 100%;
    overflow: hidden;
    color: var(--foreground);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    text-overflow: ellipsis;
    text-wrap: balance;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  post-navigation-icon {
    display: inline-flex;
    flex-shrink: 0;
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  @media (hover: hover) and (pointer: fine) {
    post-navigation-content[data-direction="previous"]:hover
      post-navigation-icon {
      transform: translateX(-0.25rem);
    }

    post-navigation-content[data-direction="parent"]:hover
      post-navigation-icon {
      transform: translate(-0.125rem, -0.125rem);
    }

    post-navigation-content[data-direction="next"]:hover post-navigation-icon {
      transform: translateX(0.25rem);
    }
  }
</style>
