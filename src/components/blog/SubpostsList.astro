---
import { type PostNavItem as PostNavItemData } from "@/lib/blog/types"
import PostNavItem from "@/components/blog/PostNavItem.astro"

interface Props {
  items: PostNavItemData[]
}

const { items } = Astro.props
---

{items.length > 0 && (
    <ul>
      {items.map((item) => (
        <li>
          <PostNavItem {...item} />
        </li>
      ))}
    </ul>
  )}

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>
