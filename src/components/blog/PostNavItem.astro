---
import type { PostNavItem as PostNavItemData } from "@/lib/blog/types"
import { getPostIconName } from "@/lib/blog/utils"
import Icon from "@/components/base/Icon.astro"
import Link from "@/components/base/Link.astro"
import ReadingTime from "@/components/base/ReadingTime.astro"
import SubpostCountBadge from "@/components/blog/SubpostCountBadge.astro"

interface Props extends PostNavItemData {}

const {
  title,
  isActive,
  isSubpost,
  wordCount,
  combinedWordCount,
  subpostCount,
  href,
} = Astro.props

const iconName = getPostIconName(isActive, isSubpost)

// For subposts, don't use combinedWordCount - only show individual reading time
// For parent posts, show both individual and combined times
const effectiveCombinedWordCount = isSubpost ? undefined : combinedWordCount
---

{isActive ? (
    <div class="post-nav-item is-active" aria-current="page">
      <post-nav-item-icon>
        <Icon
          name={iconName}
          aria-label={isSubpost ? "Current subpost" : "Current post"}
        />
      </post-nav-item-icon>
      <post-nav-item-content>
        <span>{title}</span>
        {!isSubpost && !!subpostCount && subpostCount > 0 && (
          <SubpostCountBadge count={subpostCount} variant="full" />
        )}
        {wordCount > 0 && (
          <post-nav-item-meta>
            <ReadingTime
              wordCount={wordCount}
              combinedWordCount={effectiveCombinedWordCount}
            />
          </post-nav-item-meta>
        )}
      </post-nav-item-content>
    </div>
  ) : (
    <Link href={href} class="post-nav-item">
      <post-nav-item-icon>
        <Icon
          name={iconName}
          aria-label={isSubpost ? "Subpost" : "Parent post"}
        />
      </post-nav-item-icon>
      <post-nav-item-content>
        <span>
          {title}
        </span>
        {(wordCount > 0 || (!!subpostCount && subpostCount > 0 && !isSubpost)) && (
          <post-nav-item-meta>
            {wordCount > 0 && (
              <ReadingTime wordCount={wordCount} combinedWordCount={effectiveCombinedWordCount} />
            )}
            {!!subpostCount && subpostCount > 0 && !isSubpost && (
              <SubpostCountBadge count={subpostCount} variant="compact" />
            )}
          </post-nav-item-meta>
        )}
      </post-nav-item-content>
    </Link>
  )}

<style>
  .post-nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs);
    border-radius: var(--radius-md);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    text-decoration: none;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration-fast) var(--motion-ease);
  }

  .post-nav-item:focus-visible {
    background: var(--interactive-background);
    color: var(--interactive-foreground);
    box-shadow: inset 0 0 0 1px var(--interactive-border);
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .post-nav-item[data-link]:hover {
      background: var(--interactive-background);
      color: var(--interactive-foreground);
      box-shadow: inset 0 0 0 1px var(--interactive-border);
    }
  }

  .post-nav-item.is-active {
    background: color-mix(in oklab, var(--primary) 18%, transparent);
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
  }

  post-nav-item-icon {
    display: inline-flex;
    align-self: flex-start;
    flex-shrink: 0;
    margin-block-start: 0.125rem;
    color: currentColor;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }

  post-nav-item-content {
    display: flex;
    min-inline-size: 0;
    flex-direction: column;
    gap: 0.125rem;
  }

  post-nav-item-content > span {
    display: -webkit-box;
    overflow: hidden;
    color: currentColor;
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-tight);
    text-overflow: ellipsis;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  post-nav-item-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    color: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
    font-size: var(--step--1);
  }
</style>
