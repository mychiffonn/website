---
import { Image } from "astro:assets"

import { getStageVariant } from "@/lib/blog/stage"
import type { PostMeta } from "@/lib/blog/types"
import Badge from "@/components/base/Badge.astro"
import Icon from "@/components/base/Icon.astro"
import PostMetadata from "@/components/blog/PostMetadata.astro"

import "@/styles/card.css"

interface Props {
  metadata: PostMeta
}

const { metadata } = Astro.props
const tags = metadata.tags
const hasBadges = metadata.stage || (tags && tags.length > 0)
---

<article
  class="card card-clickable preview-card"
  data-has-image={metadata.image ? "true" : "false"}
>
  <a
    href={`/blog/${metadata.id}`}
    class="preview-card-link"
    aria-label={`Post: ${metadata.title}`}
  > </a>

  {metadata.image && (
      <Image
        src={metadata.image}
        alt={metadata.title}
        width={1200}
        height={630}
        sizes="(max-width: 768px) 100vw, 60vw"
        class="cover-image"
        loading="lazy"
      />
    )}

  <div class="card-content preview-card-content">
    <preview-card-heading>
      <h3 class="card-title">
        {metadata.title}
      </h3>
    </preview-card-heading>
    <p class="card-description">
      {metadata.description}
    </p>
    <PostMetadata {...metadata} variant="card" />
    {hasBadges && (
        <div class="card-tags preview-card-badges">
          {metadata.stage && (
              <Badge variant={getStageVariant(metadata.stage)}>
                <Icon name={metadata.stage} />
                {metadata.stage}
              </Badge>
            )}
          {tags && tags.map((tag: string) => (
              <Badge variant={"muted"} class="tag-badge">
                <Icon name="hashtag" />
                {tag}
              </Badge>
            ))}
        </div>
      )}
  </div>
</article>

<style>
  .card:hover {
    background-color: oklch(from var(--muted) l c h / 0.5);

    & .tag-badge {
      background-color: oklch(from var(--muted) l c h / 0.5);
    }
  }

  .preview-card {
    position: relative;
    overflow: hidden;
  }

  .preview-card-link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .preview-card-content {
    position: relative;
    z-index: 1;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }

  .preview-card[data-has-image="true"] .preview-card-content {
    @media (width >= 48rem) {
      max-inline-size: 80%;
    }

    @media (width < 48rem) {
      padding-block-start: 6rem;
    }
  }

  .preview-card .card-title {
    transition: color var(--motion-duration) var(--motion-ease);
  }

  .preview-card:hover .card-title {
    color: var(--primary);
  }

  preview-card-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .preview-card-badges {
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .preview-card-badges::-webkit-scrollbar {
    display: none;
  }

  .cover-image {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: 0;
    inline-size: 60%;
    block-size: 100%;
    object-fit: cover;
    opacity: 0.3;
    mask: linear-gradient(to right, transparent 0%, black 100%);
    transition: opacity var(--motion-duration-slow) var(--motion-ease);
  }

  .preview-card:hover .cover-image {
    opacity: 0.5;
  }

  @media (width < 48rem) {
    .cover-image {
      inline-size: 100%;
      block-size: 66%;
      mask: linear-gradient(to top, transparent 0%, black 100%);
    }
  }
</style>
