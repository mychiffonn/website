---
export interface Props {
  class?: string
  align?: "start" | "end" | "center"
  sideOffset?: number
  id?: string
  open?: boolean
}

const {
  class: className,
  align = "start",
  sideOffset = 4,
  id = `dropdown-${Math.random().toString(36).substring(2, 9)}`,
  open = false,
  ...rest
} = Astro.props
---

<div
  data-dropdown-root
  data-state={open ? "open" : "closed"}
  style={`--dropdown-offset:${sideOffset}px`}
>
  <slot name="trigger" />
  <div
    id={id}
    data-dropdown-content
    data-align={align}
    class={className}
    role="menu"
    aria-orientation="vertical"
    tabindex="-1"
    {...rest}
  >
    <slot />
  </div>
</div>

<script>
  class DropdownMenu {
    private trigger: HTMLElement | null
    private content: HTMLElement | null
    private isOpen = false

    constructor(private container: HTMLElement) {
      this.trigger = container.querySelector("[data-dropdown-trigger]")
      this.content = container.querySelector("[data-dropdown-content]")
      if (!this.trigger || !this.content) return
      this.trigger.addEventListener("click", this.handleTriggerClick)
      this.content.addEventListener("click", this.handleContentClick)
      document.addEventListener("click", this.handleOutsideClick)
      this.container.addEventListener("dropdown-close", () => this.close())
      this.container.addEventListener("dropdown-open", () => this.open())
      if (container.dataset.state === "open") this.open()
    }

    private handleTriggerClick = (event: Event) => {
      event.preventDefault()
      event.stopPropagation()
      if (this.isOpen) this.close()
      else this.open()
    }

    private handleContentClick = (event: Event) => {
      if ((event.target as Element).closest("[data-dropdown-item]"))
        this.close()
    }

    private handleOutsideClick = (event: Event) => {
      if (!this.container.contains(event.target as Node)) this.close()
    }

    private open() {
      if (!this.content) return
      this.isOpen = true
      this.container.dataset.state = "open"
      this.position()
    }

    private close() {
      this.isOpen = false
      this.container.dataset.state = "closed"
    }

    private position() {
      if (!this.trigger || !this.content) return
      const trigger = this.trigger.getBoundingClientRect()
      const content = this.content.getBoundingClientRect()
      const margin = 10
      let left = 0
      if (this.content.dataset.align === "end")
        left = trigger.width - content.width
      if (this.content.dataset.align === "center")
        left = (trigger.width - content.width) / 2
      left = Math.min(
        left,
        window.innerWidth - trigger.left - content.width - margin,
      )
      left = Math.max(left, margin - trigger.left)
      this.content.style.left = `${left}px`
    }
  }

  function initDropdowns() {
    document
      .querySelectorAll<HTMLElement>("[data-dropdown-root]")
      .forEach((container) => {
        if (container.dataset.dropdownInitialized) return
        new DropdownMenu(container)
        container.dataset.dropdownInitialized = "true"
      })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDropdowns)
  } else {
    initDropdowns()
  }
  document.addEventListener("astro:after-swap", initDropdowns)
</script>

<style is:global>
  [data-dropdown-root] {
    position: relative;
    display: inline-block;
  }

  [data-dropdown-content] {
    position: absolute;
    display: none;
    inset-block-start: calc(100% + var(--dropdown-offset, 4px));
    inset-inline-start: 0;
    z-index: 50;
    min-inline-size: 10rem;
    max-inline-size: calc(100vw - 1.25rem);
    max-block-size: min(24rem, calc(100vh - 6rem));
    overflow: auto;
    padding-block: var(--space-3xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--background);
    color: var(--foreground);
    opacity: 0;
    visibility: hidden;
    scale: 0.98;
    transform-origin: top left;
    transition:
      display var(--motion-duration) var(--motion-ease) allow-discrete,
      opacity var(--motion-duration) var(--motion-ease),
      visibility var(--motion-duration) var(--motion-ease),
      scale var(--motion-duration) var(--motion-ease);
  }

  [data-dropdown-root][data-state="open"] [data-dropdown-content] {
    display: block;
    opacity: 1;
    visibility: visible;
    scale: 1;
  }

  @starting-style {
    [data-dropdown-root][data-state="open"] [data-dropdown-content] {
      opacity: 0;
      scale: 0.98;
    }
  }

  [data-dropdown-item] {
    display: block;
    inline-size: 100%;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration-fast) var(--motion-ease);
  }

  [data-dropdown-item]:hover {
    background: var(--muted);
  }
</style>
