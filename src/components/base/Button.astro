---
import Link from "./Link.astro"

export interface Props extends astroHTML.JSX.ButtonHTMLAttributes {
  variant?:
    | "default"
    | "primary"
    | "accent"
    | "destructive"
    | "outline"
    | "primary-outline"
    | "accent-outline"
    | "destructive-outline"
    | "ghost"
  size?: "default" | "square"
  href?: string
  external?: boolean
}

const {
  variant = "default",
  size = "default",
  class: className,
  href,
  external,
  type = "button",
  ...rest
} = Astro.props
---

{href ? (
    <Link
      href={href}
      external={external}
      data-button
      data-variant={variant}
      data-size={size}
      class={className ?? undefined}
      {...rest}
    >
      <slot />
    </Link>
  ) : (
    <button
      type={type}
      data-button
      data-variant={variant}
      data-size={size}
      class={className ?? undefined}
      {...rest}
    >
      <slot />
    </button>
  )}

<style is:global>
  [data-button] {
    --button-line-width: 1px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-block-size: 44px;
    padding: var(--space-2xs) var(--space-xs);
    border: var(--button-line-width) solid transparent;
    border-radius: var(--radius-md);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    text-decoration: none;
    touch-action: manipulation;
    user-select: none;
    cursor: pointer;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration-fast) var(--motion-ease),
      transform var(--motion-duration-fast) var(--motion-ease);

    @media (width >= 40rem) {
      --button-line-width: 0.5px;

      min-block-size: 2rem;
    }
  }

  [data-button][data-size="square"] {
    inline-size: 2.75rem;
    padding: 0;

    @media (width >= 40rem) {
      inline-size: 2rem;
    }
  }

  [data-button][data-variant="default"] {
    background: var(--muted);
    color: var(--foreground);
  }

  [data-button][data-variant="primary"],
  [data-button][data-variant="accent"] {
    background: var(--primary);
    color: var(--primary-foreground);
  }

  [data-button][data-variant="destructive"] {
    background: var(--destructive);
    color: var(--primary-foreground);
  }

  [data-button][data-variant$="outline"],
  [data-button][data-variant="outline"] {
    border-color: var(--border);
    background: transparent;
    color: var(--foreground);
  }

  [data-button][data-variant="ghost"] {
    background: transparent;
    color: var(--foreground);
  }

  [data-button]:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    [data-button][data-variant="default"]:hover {
      border-color: var(--primary);
      background: var(--primary);
      color: var(--primary-foreground);
    }

    [data-button][data-variant="primary"]:hover {
      border-color: var(--primary);
      background: var(--background);
      color: var(--foreground);
    }

    [data-button][data-variant="accent"]:hover {
      border-color: var(--accent);
      background: var(--background);
      color: var(--foreground);
    }

    [data-button][data-variant="destructive"]:hover {
      border-color: var(--destructive);
      background: var(--background);
      color: var(--foreground);
    }

    [data-button][data-variant="outline"]:hover,
    [data-button][data-variant="accent-outline"]:hover,
    [data-button][data-variant="ghost"]:hover {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--accent-foreground);
    }

    [data-button][data-variant="primary-outline"]:hover {
      border-color: var(--primary);
      background: var(--primary);
      color: var(--primary-foreground);
    }

    [data-button][data-variant="destructive-outline"]:hover {
      border-color: var(--destructive);
      background: var(--destructive);
      color: var(--accent-foreground);
    }
  }

  [data-button][aria-disabled="true"],
  [data-button]:disabled {
    opacity: 0.5;
    pointer-events: none;
    cursor: not-allowed;
  }
</style>
