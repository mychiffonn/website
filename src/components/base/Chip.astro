---
import { cn } from "@/lib/utils"

export type Props = astroHTML.JSX.ButtonHTMLAttributes

const { class: className, type = "button", ...rest } = Astro.props
---

<button
  type={type}
  data-slot="chip"
  class={cn(
    "inline-flex items-center justify-center gap-1 rounded-md border px-2 py-0.5",
    "text-xs font-medium w-fit whitespace-nowrap shrink-0 overflow-hidden",
    "[&>svg]:size-3 [&>svg]:pointer-events-none",
    "cursor-pointer transition-all",
    "bg-transparent border-border text-muted-foreground",
    "hover:border-accent hover:text-accent",
    "aria-[pressed=true]:bg-primary aria-[pressed=true]:text-primary-foreground aria-[pressed=true]:border-primary",
    "focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]",
    className
  )}
  {...rest}
>
  <slot />
</button>
