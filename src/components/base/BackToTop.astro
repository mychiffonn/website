---
import Button from "@/components/base/Button.astro"
import Icon from "@/components/base/Icon.astro"
---

<Button
  variant="outline"
  size="square"
  class="scroll-to-top"
  id="scroll-to-top"
  hidden
  title="Scroll to top"
  aria-label="Scroll to top"
>
  <Icon name="to-top" size="1.25rem" class="scroll-to-top-icon" />
</Button>

<script>
  const initializeScrollToTop = () => {
    const scrollToTopButton = document.getElementById("scroll-to-top")
    const footer = document.querySelector("footer")

    if (!scrollToTopButton || !footer) return

    const updateVisibility = () => {
      const footerRect = footer.getBoundingClientRect()
      const isFooterVisible = footerRect.top <= window.innerHeight

      scrollToTopButton.toggleAttribute(
        "hidden",
        window.scrollY <= 300 || isFooterVisible,
      )
    }

    scrollToTopButton.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" })
    })

    window.addEventListener("scroll", updateVisibility, { passive: true })
    updateVisibility()
  }

  document.addEventListener("astro:page-load", () => {
    initializeScrollToTop()
  })

  document.addEventListener("astro:after-swap", () => {
    initializeScrollToTop()
  })
</script>

<style>
  :global(.scroll-to-top) {
    position: fixed;
    right: var(--space-xs);
    bottom: var(--space-xl);
    z-index: 50;
    background: var(--background);
  }

  :global(.scroll-to-top[hidden]) {
    display: none;
  }

  :global(.scroll-to-top-icon) {
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  :global(.scroll-to-top:hover .scroll-to-top-icon) {
    transform: translateY(-0.25rem);
  }
</style>
