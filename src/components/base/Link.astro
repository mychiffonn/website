---
interface Props {
  href: string
  external?: boolean
  class?: string
  underline?: boolean
  [key: string]: any
}

const { href, external, class: className, underline, ...rest } = Astro.props
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer nofollow" : undefined}
  data-link
  data-underline={underline || undefined}
  class={className}
  {...rest}
>
  <slot />
</a>

<style is:global>
  [data-link] {
    color: inherit;
    transition:
      color var(--motion-duration-fast) var(--motion-ease),
      text-decoration-color var(--motion-duration) var(--motion-ease);
  }

  [data-link]:hover {
    color: var(--accent);
  }

  [data-link][data-underline] {
    --underline: var(--muted-foreground);
  }
</style>
