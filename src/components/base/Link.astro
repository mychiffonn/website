---
interface Props {
  href: string
  external?: boolean
  class?: string
  underline?: boolean
  [key: string]: any
}

const {
  href,
  external,
  class: className,
  underline,
  rel,
  ...rest
} = Astro.props
const isExternal = external ?? /^https?:\/\//.test(href)

/* A caller-supplied rel has to be merged rather than replaced, since the
   external hardening applies either way.
   `rel="me"` claims the target as the author's own profile, so marking it
   nofollow would contradict the claim and undercut the identity link. The
   window/referrer hardening still applies. */
const isIdentityLink = rel?.split(/\s+/).includes("me") ?? false
const relTokens = [
  ...(isExternal
    ? ["noopener", "noreferrer", ...(isIdentityLink ? [] : ["nofollow"])]
    : []),
  ...(rel?.split(/\s+/).filter(Boolean) ?? []),
]
const relValue = relTokens.length > 0 ? relTokens.join(" ") : undefined
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={relValue}
  data-link
  data-external={isExternal || undefined}
  data-underline={underline || undefined}
  class={className}
  {...rest}
>
  <slot />
</a>

<style>
  [data-link] {
    color: inherit;
    transition:
      color var(--motion-duration-fast) var(--motion-ease),
      text-decoration-color var(--motion-duration) var(--motion-ease),
      background-size var(--motion-duration) var(--motion-ease);
  }

  @media (hover: hover) and (pointer: fine) {
    [data-link]:hover {
      color: var(--accent);
    }
  }

  /* Opting in here (rather than on every [data-link]) keeps the wipe off the
     button- and badge-shaped anchors that also render through this component. */
  [data-link][data-underline] {
    --underline: var(--muted-foreground);
    --underline-wipe: currentColor;
  }
</style>
