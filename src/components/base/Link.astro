---
interface Props {
  href: string
  external?: boolean
  class?: string
  underline?: boolean
  [key: string]: any
}

const {
  href,
  external,
  class: className,
  underline,
  rel,
  ...rest
} = Astro.props
const isExternal = external ?? /^https?:\/\//.test(href)

const isIdentityLink = rel?.split(/\s+/).includes("me") ?? false
const relTokens = [
  ...(isExternal
    ? ["noopener", "noreferrer", ...(isIdentityLink ? [] : ["nofollow"])]
    : []),
  ...(rel?.split(/\s+/).filter(Boolean) ?? []),
]
const relValue = relTokens.length > 0 ? relTokens.join(" ") : undefined
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={relValue}
  data-link
  data-external={isExternal || undefined}
  data-underline={underline || undefined}
  class={className}
  {...rest}
>
  <slot />
</a>

<style>
  [data-link] {
    color: inherit;
    cursor: pointer;
    transition:
      color var(--motion-duration-fast) var(--motion-ease),
      text-decoration-color var(--motion-duration) var(--motion-ease),
      background-size var(--motion-duration) var(--motion-ease);
  }

  @media (hover: hover) and (pointer: fine) {
    [data-link]:hover {
      color: var(--accent);
    }
  }

  [data-link][data-underline] {
    --underline: var(--muted-foreground);
    --underline-wipe: currentColor;
    text-decoration-skip-ink: auto;
  }

  [data-link][data-underline]:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }
</style>
