---
import type { RenderedUpdate } from "@/lib/updates"
import FormattedDate from "@/components/base/FormattedDate.astro"

interface Props {
  renderedUpdates: RenderedUpdate[]
  class?: string
  itemClass?: string
}

const { renderedUpdates, class: className, itemClass } = Astro.props
---

<div class:list={["updates-inline", className]}>
  {renderedUpdates.map((item) => (
    <article>
      <FormattedDate date={item.date} class="update-date" />
      <div class:list={["update-content prose", itemClass]}>
        <item.Content />
      </div>
    </article>
  ))}
</div>

<style>
  .updates-inline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  article {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    @media (width >= 40rem) {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-xs);
    }
  }

  :global(.update-date) {
    flex-shrink: 0;
    color: var(--muted-foreground);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
  }

  .update-content {
    min-inline-size: 0;
  }
</style>
