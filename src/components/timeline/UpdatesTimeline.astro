---
import type { RenderedUpdate } from "@/lib/updates"
import FormattedDate from "@/components/base/FormattedDate.astro"
import Timeline from "@/components/timeline/Timeline.astro"
import TimelineItem from "@/components/timeline/TimelineItem.astro"

interface Props {
  renderedUpdates: RenderedUpdate[]
  class?: string
  itemClass?: string
}

const { renderedUpdates, class: className, itemClass } = Astro.props
---

<Timeline class={className}>
  {renderedUpdates.map((item) => (
    <TimelineItem>
      <FormattedDate slot="date" date={item.date} class="timeline-date" />
      <prose-content class:list={["prose-sm", itemClass]}>
        <item.Content />
      </prose-content>
    </TimelineItem>
  ))}
</Timeline>

<style>
  :global(.timeline-date) {
    display: block;
    margin-block-end: var(--space-3xs);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
  }
</style>
