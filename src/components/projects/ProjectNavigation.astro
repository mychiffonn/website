---
import type { Project } from "@/lib/projects"
import Button from "@/components/base/Button.astro"
import Icon from "@/components/base/Icon.astro"

interface Props {
  prev?: Project | null
  next?: Project | null
}

const { prev, next } = Astro.props
---

<nav class="project-navigation">
  <Button
    href={prev ? `/projects/${prev.id}` : undefined}
    variant="outline"
    class="project-navigation-link"
    data-direction="previous"
    aria-disabled={!prev}
  >
    <Icon name="arrow-left" class="project-navigation-icon" />
    <project-navigation-label>
      <span>Previous Project</span>
      <strong>
        {prev?.data.title || "You're at the first project!"}
      </strong>
    </project-navigation-label>
  </Button>

  <Button
    href={next ? `/projects/${next.id}` : undefined}
    variant="outline"
    class="project-navigation-link"
    data-direction="next"
    aria-disabled={!next}
  >
    <project-navigation-label>
      <span>Next Project</span>
      <strong>
        {next?.data.title || "You're at the last project!"}
      </strong>
    </project-navigation-label>
    <Icon name="arrow-right" class="project-navigation-icon" />
  </Button>
</nav>

<style>
  .project-navigation {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);

    @media (width >= 40rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  :global(.project-navigation-link) {
    inline-size: 100%;
    min-block-size: 4rem;
    border-radius: var(--radius-lg);
  }

  :global(.project-navigation-link[aria-disabled="true"]) {
    opacity: 0.5;
    pointer-events: none;
    cursor: not-allowed;
  }

  :global(.project-navigation-link[data-direction="previous"]) {
    justify-content: flex-start;
  }

  :global(.project-navigation-link[data-direction="next"]) {
    justify-content: flex-end;
  }

  project-navigation-label {
    display: flex;
    min-inline-size: 0;
    flex-direction: column;
    overflow: hidden;
    text-wrap: pretty;
  }

  [data-direction="previous"] project-navigation-label {
    align-items: flex-start;
    text-align: start;
  }

  [data-direction="next"] project-navigation-label {
    align-items: flex-end;
    text-align: end;
  }

  project-navigation-label span {
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  project-navigation-label strong {
    display: -webkit-box;
    inline-size: 100%;
    overflow: hidden;
    color: var(--foreground);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    text-overflow: ellipsis;
    text-wrap: balance;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global(.project-navigation-icon) {
    flex-shrink: 0;
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  :global(
    .project-navigation-link[data-direction="previous"]:hover
      .project-navigation-icon
  ) {
    transform: translateX(-0.25rem);
  }

  :global(
    .project-navigation-link[data-direction="next"]:hover
      .project-navigation-icon
  ) {
    transform: translateX(0.25rem);
  }
</style>
