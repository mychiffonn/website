---
import Badge from "@/components/base/Badge.astro"

interface ProjectSkill {
  label: string
  count: number
}

interface Props {
  skills: ProjectSkill[]
}

const { skills } = Astro.props
---

<div class="tech-stack">
  <p class="tech-stack-description">
    Skills and technologies represented across these projects.
  </p>
  <ul class="tech-stack-items" aria-label="Project skills and technologies">
    {skills.map(({ label }) => (
      <li><Badge variant="muted">{label}</Badge></li>
    ))}
  </ul>
</div>

<style>
  .tech-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .tech-stack-description {
    max-inline-size: 68ch;
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--step--1);
    text-wrap: pretty;
  }

  .tech-stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-3xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tech-stack-items :global([data-badge]) {
    font-weight: var(--font-weight-normal);
  }
</style>
