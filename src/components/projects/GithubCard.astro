---
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/base/card"
import Icon from "@/components/base/Icon.astro"

interface Props {
  repo: string
  contributor?: string
}

const { repo: repoRaw, contributor } = Astro.props

const repoPath = repoRaw.replace(/^https?:\/\/github\.com\//, "")
const [owner = "github", repoName = "repository"] = repoPath
  .replace(/^\/+|\/+$/g, "")
  .split("/")
const repo = owner + "/" + repoName
const repoUrl = "https://github.com/" + repo
---

<github-card
  data-repo={repo}
  data-contributor={contributor}
  data-state="loading"
>
  <Card
    href={repoUrl}
    external
    label={"Open " + owner + "/" + repoName + " on GitHub"}
    class="github-card"
    aria-busy="true"
  >
    <CardHeader class="github-card-header">
      <CardTitle class="github-card-repo">
        <span class="github-card-owner">{owner}</span>
        <span class="github-card-separator">/</span>
        <span class="github-card-name">{repoName}</span>
      </CardTitle>
    </CardHeader>

    <div class="github-card-highlights" aria-label="Contribution details">
      <span
        class="github-card-highlight"
        title={contributor
          ? `Merged pull requests by @${contributor}`
          : "Open pull requests"}
      >
        <Icon name="mingcute:git-merge-line" />
        <strong data-gh-pulls>—</strong>
        <span data-gh-pull-label>
          {contributor ? `merged PRs by @${contributor}` : "open pull requests"}
        </span>
      </span>
    </div>

    <CardDescription data-gh-description>
      Loading the latest project details from GitHub…
    </CardDescription>

    <CardFooter class="github-card-footer">
      <div class="github-card-stats" aria-label="Repository statistics">
        <span class="github-card-stat" title="Stars">
          <Icon name="mingcute:code-line" />
          <span data-gh-language>—</span>
        </span>
        <span class="github-card-stat" title="Stars">
          <Icon name="mingcute:star-line" />
          <span data-gh-stars>—</span>
          <span class="sr-only">stars</span>
        </span>
        <span class="github-card-stat" title="Forks">
          <Icon name="mingcute:git-branch-line" />
          <span data-gh-forks>—</span>
          <span class="sr-only">forks</span>
        </span>
        <span class="github-card-stat" title="Open issues and pull requests">
          <Icon name="mingcute:bug-line" />
          <span data-gh-issues>—</span>
          <span class="sr-only">open issues and pull requests</span>
        </span>
        <span class="github-card-stat" title="License">
          <Icon name="mingcute:balance-line" />
          <span data-gh-license>—</span>
        </span>
      </div>
      <span class="github-card-updated" data-gh-updated aria-live="polite">
        Syncing with GitHub…
      </span>
    </CardFooter>
  </Card>
</github-card>

<style>
  github-card {
    display: block;
  }

  .github-card {
    --spotlight-x: 50%;
    --spotlight-y: 50%;

    gap: var(--space-s);
    border-color: color-mix(in oklab, var(--primary) 30%, var(--border));
    background:
      linear-gradient(
        140deg,
        color-mix(in oklab, var(--primary) 9%, transparent),
        transparent 44%
      ),
      color-mix(in oklab, var(--background) 96%, transparent);
    color: var(--foreground);
  }

  .github-card::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: radial-gradient(
      20rem circle at var(--spotlight-x) var(--spotlight-y),
      color-mix(in oklab, var(--accent) 12%, transparent),
      transparent 40%
    );
    content: "";
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--motion-duration) var(--motion-ease);
  }

  .github-card-header {
    gap: var(--space-2xs);
  }

  .github-card :global(.github-card-repo),
  .github-card-highlights,
  .github-card-highlight,
  .github-card-stats,
  .github-card-stat,
  .github-card-updated {
    display: flex;
    align-items: center;
  }

  .github-card :global(.github-card-repo) {
    flex-wrap: wrap;
    gap: var(--space-3xs);
    font-size: var(--step-2);
    letter-spacing: -0.025em;
  }

  .github-card-owner {
    color: var(--muted-foreground);
    font-weight: var(--font-weight-medium);
  }

  .github-card-name {
    color: var(--foreground);
    font-weight: var(--font-weight-bold);
  }

  .github-card-separator {
    color: var(--primary);
  }

  .github-card-highlights {
    position: relative;
    z-index: 1;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
    color: var(--muted-foreground);
  }

  .github-card-highlight {
    gap: var(--space-2xs);
    font-size: var(--step--1);
    line-height: var(--line-height-tight);
  }

  .github-card-highlight > :global(svg) {
    color: var(--accent);
    font-size: 1.2em;
  }

  .github-card-highlight strong {
    color: var(--foreground);
    font-variant-numeric: tabular-nums;
  }

  .github-card-footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-xs);
  }

  .github-card-stats {
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .github-card-stat {
    gap: var(--space-2xs);
    color: var(--muted-foreground);
    font-size: var(--step-0);
    font-variant-numeric: tabular-nums;
    line-height: var(--line-height-tight);
  }

  .github-card-stat > :global(svg) {
    color: var(--accent);
    font-size: 1.15em;
  }

  .github-card-updated {
    gap: var(--space-3xs);
    color: var(--muted-foreground);
    font-size: var(--step--2);
    text-align: end;
  }

  .github-card-updated::before {
    inline-size: 0.42rem;
    block-size: 0.42rem;
    flex: none;
    border-radius: var(--radius-full);
    background: var(--primary);
    content: "";
  }

  github-card[data-state="loading"] [data-gh-description],
  github-card[data-state="loading"] .github-card-highlight,
  github-card[data-state="loading"] .github-card-stat,
  github-card[data-state="loading"] .github-card-updated {
    opacity: 0.58;
  }

  github-card[data-state="error"] .github-card-updated::before {
    background: var(--muted-foreground);
  }

  @media (width < 40rem) {
    .github-card-header {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
    }

    .github-card-footer {
      grid-template-columns: minmax(0, 1fr);
    }

    .github-card-updated {
      text-align: start;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .github-card:hover::before {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .github-card::before {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  interface GithubRepository {
    description: string | null
    forks_count: number
    language: string | null
    license?: { spdx_id: string } | null
    open_issues_count: number
    pushed_at: string | null
    stargazers_count: number
  }

  class GithubRepositoryCard extends HTMLElement {
    private async fetchGithub(repo: string): Promise<GithubRepository | null> {
      try {
        const response = await fetch("https://api.github.com/repos/" + repo, {
          headers: { Accept: "application/vnd.github+json" },
          referrerPolicy: "no-referrer",
        })
        if (!response.ok) return null
        return (await response.json()) as GithubRepository
      } catch {
        return null
      }
    }

    private async fetchPullRequestCount(
      repo: string,
      contributor?: string,
    ): Promise<number | null> {
      const query = contributor
        ? `repo:${repo} is:pr is:merged author:${contributor}`
        : `repo:${repo} is:pr is:open`

      try {
        const response = await fetch(
          "https://api.github.com/search/issues?q=" + encodeURIComponent(query),
          {
            headers: { Accept: "application/vnd.github+json" },
            referrerPolicy: "no-referrer",
          },
        )
        if (!response.ok) return null
        const data = (await response.json()) as { total_count: number }
        return data.total_count
      } catch {
        return null
      }
    }

    private numberFormat(value: number): string {
      return Intl.NumberFormat("en-US", {
        notation: "compact",
        maximumFractionDigits: 1,
      }).format(value)
    }

    private relativeDate(value: string | null): string {
      if (!value) return "Update date unavailable"

      const elapsedDays = Math.round(
        (new Date(value).getTime() - Date.now()) / 86_400_000,
      )
      const formatter = new Intl.RelativeTimeFormat("en-US", {
        numeric: "auto",
      })

      if (Math.abs(elapsedDays) < 30) {
        return "Updated " + formatter.format(elapsedDays, "day")
      }

      const elapsedMonths = Math.round(elapsedDays / 30)
      if (Math.abs(elapsedMonths) < 12) {
        return "Updated " + formatter.format(elapsedMonths, "month")
      }

      return (
        "Updated " + formatter.format(Math.round(elapsedMonths / 12), "year")
      )
    }

    private setText(selector: string, value: string): void {
      const element = this.querySelector<HTMLElement>(selector)
      if (element) element.textContent = value
    }

    private enhanceSpotlight(card: HTMLElement): void {
      if (this.dataset.spotlightReady === "true") return
      this.dataset.spotlightReady = "true"

      card.addEventListener("pointermove", (event) => {
        const bounds = card.getBoundingClientRect()
        card.style.setProperty(
          "--spotlight-x",
          String(event.clientX - bounds.left) + "px",
        )
        card.style.setProperty(
          "--spotlight-y",
          String(event.clientY - bounds.top) + "px",
        )
      })
    }

    async connectedCallback(): Promise<void> {
      const repo = this.dataset.repo
      const contributor = this.dataset.contributor
      const card = this.querySelector<HTMLElement>("[data-slot='card']")
      if (!repo || !card) return

      this.enhanceSpotlight(card)
      const [data, pullRequestCount] = await Promise.all([
        this.fetchGithub(repo),
        this.fetchPullRequestCount(repo, contributor),
      ])

      card.setAttribute("aria-busy", "false")

      if (!data) {
        this.dataset.state = "error"
        this.setText(
          "[data-gh-description]",
          "Live details are unavailable right now. The repository is still one click away.",
        )
        this.setText("[data-gh-updated]", "GitHub sync unavailable")
        this.setText("[data-gh-language]", "Language unavailable")
        return
      }

      this.setText("[data-gh-stars]", this.numberFormat(data.stargazers_count))
      this.setText("[data-gh-forks]", this.numberFormat(data.forks_count))
      this.setText(
        "[data-gh-issues]",
        this.numberFormat(data.open_issues_count),
      )
      this.setText("[data-gh-license]", data.license?.spdx_id || "No license")
      this.setText("[data-gh-language]", data.language || "Mixed languages")
      this.setText(
        "[data-gh-pulls]",
        pullRequestCount === null ? "—" : this.numberFormat(pullRequestCount),
      )
      this.setText("[data-gh-updated]", this.relativeDate(data.pushed_at))
      this.setText(
        "[data-gh-description]",
        data.description?.replace(/:[a-zA-Z0-9_]+:/g, "").trim() ||
          "An open-source project on GitHub.",
      )
      this.dataset.state = "ready"
    }
  }

  if (!customElements.get("github-card")) {
    customElements.define("github-card", GithubRepositoryCard)
  }
</script>
