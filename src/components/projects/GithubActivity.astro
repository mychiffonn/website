---
import { Image } from "astro:assets"

import Link from "@/components/base/Link.astro"
import Section from "@/components/layout/Section.astro"

interface Props {
  class?: string
  username?: string
  githubUrl?: string
}

const {
  class: className,
  username,
  githubUrl = "https://github.com",
} = Astro.props

// Extract username from githubUrl if not provided
const ghUser = username || githubUrl?.split("/").pop() || ""
---

{ghUser && (
    <Section title="GitHub Activity" class:list={["github-activity", className]}>
      <p>
        My{" "}
        <Link href={githubUrl} external class="github-activity-link">
          GitHub ↗
        </Link>{" "}
        contributions over the past year. Colored squares represent days with commits.
      </p>
      <div class="github-activity-chart">
        <Image
          src={`https://ghchart.rshah.org/659eb9/${ghUser}`}
          alt="GitHub contribution chart"
          width={896}
          height={128}
          loading="lazy"
          class="github-activity-image"
        />
      </div>
    </Section>
  )}

<style>
  :global(.github-activity) {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .github-activity p {
    color: var(--muted-foreground);
  }

  :global(.github-activity-link) {
    color: var(--primary);
  }

  .github-activity-chart {
    display: flex;
    justify-content: center;
    margin-block-end: var(--space-s);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background);
  }

  :global(.github-activity-image) {
    inline-size: 100%;
    padding: var(--space-s);
  }
</style>
