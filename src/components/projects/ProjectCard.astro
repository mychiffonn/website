---
import type { CollectionEntry } from "astro:content"

import { getProjectLinks } from "@/lib/projects"
import { cn } from "@/lib/utils"
import Badge from "@/components/base/Badge.astro"
import Button from "@/components/base/Button.astro"
import Icon from "@/components/base/Icon.astro"
import DateRange from "@/components/projects/DateRange.astro"

import "@/styles/card.css"

interface Props {
  project: CollectionEntry<"projects">
}

const { project } = Astro.props
const {
  title,
  isHighlighted,
  fromDate,
  toDate,
  code,
  doc,
  url,
  release,
  category,
  tags,
} = project.data

const links = getProjectLinks(code, doc, url, release)

const hasDetailPage = !!project.body?.trim()

const cardClasses = cn(
  "card card-content",
  isHighlighted && "card-selected",
  hasDetailPage && "card-clickable project-card-clickable",
)
---

<article
  class={cardClasses}
  data-project-categories={category?.join(",") ?? ""}
>
  {hasDetailPage && (
      <a
        href={`/projects/${project.id}`}
        class="project-card-link"
        aria-label={`View details for ${title}`}
      />
    )}

  <div class="card-header">
    <h3 class="card-title">{title}</h3>
  </div>

  <div class="card-meta">
    <DateRange fromDate={fromDate} toDate={toDate} class="project-date-range" />
  </div>

  {project.data.description && <p class="card-description">{project.data.description}</p>}
  {tags && tags.length > 0 && (
      <div class="card-tags">
        {tags.map((tag: string) => (
          <Badge variant="muted" class="project-tag">
            {tag}
          </Badge>
        ))}
      </div>
    )}
  {links.length > 0 && (
      <div class="card-actions">
        {links.map(({ href, icon, label }) => (
          <Button href={href} variant="accent-outline">
            <Icon name={icon} />
            <span>{label}</span>
          </Button>
        ))}
      </div>
    )}
</article>

<style>
  .project-card-clickable {
    position: relative;
  }

  .project-card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-header,
  .card-meta,
  .card-description,
  .card-tags,
  .card-actions {
    position: relative;
  }

  .card-title,
  .card-meta {
    font-size: var(--step-0);
  }

  .project-date-range {
    display: flex;
    gap: 0.25rem;
  }

  .project-tag {
    padding: 0.125rem 0.375rem;
    font-size: var(--step--1);
    line-height: 1.15;
  }

  .card-actions {
    z-index: 2;
  }
</style>
