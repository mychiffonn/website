---
import type { CollectionEntry } from "astro:content"

import { getProjectLinks } from "@/lib/projects"
import { slugify } from "@/lib/string-manipulation"
import Badge from "@/components/base/Badge.astro"
import Button from "@/components/base/Button.astro"
import Icon from "@/components/base/Icon.astro"
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
  CardMeta,
  CardTitle,
} from "@/components/base/card"
import DateRange from "@/components/projects/DateRange.astro"

interface Props {
  project: CollectionEntry<"projects">
}

const { project } = Astro.props
const {
  title,
  isHighlighted,
  fromDate,
  toDate,
  code,
  doc,
  paper,
  url,
  release,
  types,
  skills,
} = project.data

const links = getProjectLinks(code, doc, paper, url, release)

const hasDetailPage = !!project.body?.trim()
---

<Card
  href={hasDetailPage ? `/projects/${project.id}` : undefined}
  label={hasDetailPage ? `View details for ${title}` : undefined}
  selected={isHighlighted}
  class="project-card"
  data-project-types={types.join(",")}
  data-project-skills={skills.map((skill) => slugify(skill)).join(",")}
>
  <CardHeader>
    <CardTitle>{title}</CardTitle>
  </CardHeader>

  <CardMeta>
    <DateRange fromDate={fromDate} toDate={toDate} class="project-date-range" />
  </CardMeta>

  {project.data.description && (
    <CardDescription>{project.data.description}</CardDescription>
  )}
  {skills.length > 0 && (
      <CardFooter class="project-tags">
        {skills.map((skill) => (
          <Badge variant="muted" class="project-tag">
            {skill}
          </Badge>
        ))}
      </CardFooter>
    )}
  {links.length > 0 && (
      <CardFooter class="project-actions">
        {links.map(({ href, icon, label }) => (
          <Button href={href} variant="accent-outline">
            <Icon name={icon} />
            <span>{label}</span>
          </Button>
        ))}
      </CardFooter>
    )}
</Card>

<style>
  .project-card :global([data-slot="card-title"]),
  .project-card :global([data-slot="card-meta"]) {
    font-size: var(--step-0);
  }

  .project-date-range {
    display: flex;
    gap: 0.25rem;
  }

  .project-tag {
    padding: 0.125rem 0.375rem;
    font-size: var(--step--1);
    line-height: 1.15;
  }

  .project-actions {
    z-index: 2;
  }
</style>
