---
import CopyButton from "@/components/base/CopyButton.astro"
import Icon from "@/components/base/Icon.astro"
import Link from "@/components/base/Link.astro"

import { getTransformedEmail } from "./helper"

interface Props {
  email: string
  showIcon?: boolean
  showCopyButton?: boolean
}

const { email, showIcon = true, showCopyButton = true } = Astro.props
const displayEmail = getTransformedEmail(email, "display")
---

<span class="email-link">
  {showIcon && <Icon name="mingcute:mail-line" />}
  <Link
    href={`mailto:${email}`}
    aria-label={`Send email to ${displayEmail}`}
    title={`Send email to ${displayEmail}`}
    external
  >
    {displayEmail}
  </Link>
  {showCopyButton && (
      <CopyButton
        text={email}
        title="Copy email address"
        size="1.5rem"
        class="email-copy"
      />
    )}
</span>

<style>
  .email-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .email-link :global(svg) {
    inline-size: 1.375rem;
    block-size: 1.375rem;
  }

  .email-link :global(.email-copy) {
    padding: 0.25rem;
    border-radius: var(--radius-sm);
    outline: 2px solid transparent;
    transition:
      color var(--motion-duration-fast) var(--motion-ease),
      outline-color var(--motion-duration) var(--motion-ease);
  }

  .email-link :global(.email-copy:hover) {
    color: var(--accent);
    outline-color: var(--ring);
  }
</style>
