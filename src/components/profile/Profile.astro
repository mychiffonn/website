---
import type { ProfileConfig } from "@/types"

import Avatar from "@/components/base/Avatar.astro"
import Badge from "@/components/base/Badge.astro"
import Collapse from "@/components/base/Collapse.astro"
import Icon from "@/components/base/Icon.astro"
import avatar from "@/assets/avatar.jpg"

import EmailLink from "./EmailLink.astro"
import ProfileLinks from "./ProfileLinks.astro"
import { Content as AboutContent } from "@/content/about.md"

interface Props {
  profile: ProfileConfig
}

const { profile } = Astro.props
---

<article id="profile">
  <header class="profile-header">
    <Avatar
      src={avatar}
      alt={profile.name}
      fallback={profile.name.charAt(0)}
      data-slot="profile-avatar"
      width={200}
      height={200}
      loading="eager"
      fetchpriority="high"
      class="profile-avatar"
    />

    <div class="profile-content">
      <div class="profile-heading">
        <h1>
          {profile.name}
          {profile.pronouns && (
              <Badge variant="outline" class="profile-pronouns">
                {profile.pronouns}
              </Badge>
            )}
        </h1>
        {profile.othernames && <p class="profile-othernames">{profile.othernames}</p>}
        <p class="profile-tagline">{profile.tagline}</p>
      </div>
      {profile.pronunciation && (
          <Collapse title="Pronunciation" variant="muted">
            <p class="profile-pronunciation">{profile.pronunciation}</p>
          </Collapse>
        )}
    </div>
  </header>
</article>

<prose-content>
  <AboutContent />
</prose-content>

<footer class="profile-footer">
  <EmailLink email={profile.email} />

  {profile.location && (
      <span class="profile-contact-item">
        <Icon name="mingcute:location-line" />
        <span>{profile.location}</span>
      </span>
    )}

  {profile.phone && (
      <span class="profile-contact-item">
        <Icon name="mingcute:phone-line" />
        <span>{profile.phone}</span>
      </span>
    )}

  <ProfileLinks highlight />
</footer>

<style>
  .profile-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
  }

  #profile {
    margin-block-start: var(--space-s);
  }

  .profile-avatar {
    inline-size: 7rem;
    block-size: 7rem;
    align-self: center;
  }

  .profile-content {
    flex: 1;
    display: grid;
    gap: var(--space-s);
  }

  .profile-heading {
    display: grid;
    gap: var(--space-2xs);
  }

  .profile-heading h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    font-size: var(--step-3);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
  }

  .profile-pronouns {
    font-size: var(--step--1);
  }

  .profile-othernames,
  .profile-pronunciation {
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .profile-tagline {
    color: var(--foreground);
  }

  .profile-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    padding-block-start: var(--space-s);
    padding-inline: var(--space-s);
    color: var(--muted-foreground);
  }

  .profile-contact-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .profile-contact-item :global(svg) {
    inline-size: 1rem;
    block-size: 1rem;
  }

  @media (width >= 40rem) {
    .profile-header {
      flex-direction: row;
      align-items: flex-start;
    }

    .profile-avatar {
      inline-size: 12.5rem;
      block-size: 12.5rem;
      align-self: flex-start;
    }

    .profile-heading h1 {
      font-size: var(--step-3);
    }
  }
</style>
