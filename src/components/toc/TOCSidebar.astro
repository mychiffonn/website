---
import type { TOCSection } from "@/lib/toc"
import ScrollArea from "@/components/toc/ScrollArea.astro"
import TOCSectionComponent from "@/components/toc/TOCSection.astro"

interface Props {
  sections: TOCSection[]
  currentPostId: string
  class?: string
}

const { sections, currentPostId, class: className } = Astro.props

const hasSections = sections.length > 0
---

{hasSections && (
    <aside
      id="toc-sidebar-container"
      role="complementary"
      aria-labelledby="toc-heading"
      class:list={["toc-sidebar", className]}
    >
      <header>
        <h2 id="toc-heading">
          Table of Contents
        </h2>
      </header>
      <ScrollArea data-scroll-area>
        <ol role="navigation" aria-labelledby="toc-heading">
          {sections.map((section: TOCSection, index: number) => {
            const isFirstSubpost = section.isSubpost && !sections[index - 1]?.isSubpost

            return (
              <li>
                {isFirstSubpost && (
                  <toc-separator role="separator" aria-label="Subposts section">
                    <span />
                    <strong>
                      Subposts
                    </strong>
                    <span />
                  </toc-separator>
                )}
                <TOCSectionComponent
                  id={section.postId}
                  title={section.postTitle}
                  isActive={section.postId === currentPostId}
                  headings={section.headings}
                />
              </li>
            )
          })}
        </ol>
      </ScrollArea>
    </aside>
  )}

<style>
  .toc-sidebar {
    --scroll-area-display: flex;
    --scroll-area-flex-direction: column;
    --scroll-area-gap: var(--space-2xs);
    --scroll-area-max-block-size: calc(100dvh - var(--header-height, 4rem));
    --scroll-area-padding: var(--space-2xs);
  }

  .toc-sidebar header {
    position: sticky;
    top: 0;
    margin-block-end: var(--space-2xs);
    padding-block-end: var(--space-3xs);
    border-block-end: 1px solid var(--border);
  }

  h2 {
    color: color-mix(in oklab, var(--foreground) 80%, transparent);
    font-size: var(--step--1);
    font-weight: var(--font-weight-semibold);
  }

  ol {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  toc-separator {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-block-end: var(--space-s);
  }

  toc-separator span {
    block-size: 1px;
    flex: 1;
    background: var(--border);
  }

  toc-separator strong {
    padding-inline: var(--space-2xs);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
  }
</style>

<script>
  import { SITE } from "@site-config"
  import { UnifiedTOCController } from "@/lib/toc"

  let controller: UnifiedTOCController | null = null

  function initController() {
    controller?.cleanup()
    controller = new UnifiedTOCController(
      "#toc-sidebar-container",
      "#toc-sidebar-container [data-heading-link]",
      { tocMaxDepth: SITE.tocMaxDepth },
    )
    controller.init()
  }

  function cleanupController() {
    controller?.cleanup()
    controller = null
  }

  document.addEventListener("astro:page-load", initController)
  document.addEventListener("astro:after-swap", initController)
  document.addEventListener("astro:before-swap", cleanupController)
</script>
