---
import type { MarkdownHeading } from "astro"

import type { TOCHeadingItem } from "@/lib/toc"

interface Props {
  heading: MarkdownHeading | TOCHeadingItem
  href?: string
  class?: string
}

const { heading, href: propHref, class: className } = Astro.props

// Use heading.href if it exists (TOCHeadingItem), otherwise use prop href or construct from slug
const href = "href" in heading ? heading.href : propHref || `#${heading.slug}`
---

<li>
  <a
    href={href}
    class:list={["toc-item", className]}
    data-heading-link={heading.slug}
    data-depth={heading.depth}
  >
    <span>{heading.text}</span>
  </a>
</li>

<style>
  .toc-item {
    display: block;
    margin-inline-start: calc(var(--depth-offset, 0) * var(--space-s));
    padding: 0.25rem var(--space-2xs);
    border-radius: var(--radius-sm);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    text-decoration: none;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration-fast) var(--motion-ease);
  }

  .toc-item:hover {
    background: color-mix(in oklab, var(--accent) 50%, transparent);
    color: color-mix(in oklab, var(--accent-foreground) 50%, transparent);
  }

  .toc-item:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .toc-item[data-active] {
    background: color-mix(in oklab, var(--accent) 30%, transparent);
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
  }

  .toc-item[data-depth="3"] {
    --depth-offset: 1;
  }

  .toc-item[data-depth="4"] {
    --depth-offset: 2;
  }

  .toc-item[data-depth="5"] {
    --depth-offset: 3;
  }

  .toc-item[data-depth="6"] {
    --depth-offset: 4;
  }

  span {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
