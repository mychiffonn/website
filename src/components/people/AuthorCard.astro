---
import type { AuthorData } from "@/lib/blog/types"
import ProfileLinks from "@/components/profile/ProfileLinks.astro"

import AuthorAvatar from "./AuthorAvatar.astro"

import "@/styles/card.css"

interface Props {
  author: AuthorData
  variant?: "full" | "compact"
}

const { author, variant = "full" } = Astro.props
const { id, name, bio, pronouns, links } = author
const isAuthorPage = Astro.url.pathname === `/people/${id}`
const isCompact = variant === "compact"
const isClickable = !isCompact && !isAuthorPage
---

<article
  class:list={[
    "author-card",
    "card",
    { "author-card-compact": isCompact, "card-clickable": isClickable }
  ]}
>
  {!isCompact && !isAuthorPage && (
      <a
        href={`/people/${id}`}
        class="author-card-link"
        aria-label={`View profile for ${name}`}
      />
    )}

  <AuthorAvatar
    author={author}
    fallbackStyle="all-initials"
    class:list={["author-card-avatar", { "author-card-avatar-compact": isCompact }]}
  />

  <div class="author-card-body">
    <div>
      <div class="author-card-heading">
        {isCompact ? (
            <a href={`/people/${id}`} class="author-card-name-link">
              {name}
            </a>
          ) : (
            <h3>{name}</h3>
          )}
        {pronouns && <span class="author-card-pronouns">({pronouns})</span>}
      </div>
      {bio && <p class:list={["author-card-bio", { "author-card-bio-compact": isCompact }]}>{bio}</p>}
    </div>

    {!isCompact && <ProfileLinks links={links} class="author-card-profile-links" />}
  </div>
</article>

<style>
  .author-card {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    padding-block: var(--space-s);
  }

  .author-card-compact {
    align-items: flex-start;
    gap: var(--space-2xs);
    padding-block: var(--space-2xs);
  }

  .author-card-link {
    position: absolute;
    inset: 0;
    z-index: 20;
  }

  :global(.author-card-avatar) {
    position: relative;
    z-index: 10;
    flex-shrink: 0;
    inline-size: 10rem;
    block-size: 10rem;
  }

  :global(.author-card-avatar-compact) {
    inline-size: 3rem;
    block-size: 3rem;
  }

  .author-card-body {
    position: relative;
    z-index: 10;
    display: flex;
    flex: 1 1 16rem;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .author-card-compact .author-card-body {
    gap: var(--space-3xs);
  }

  .author-card-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-2xs);
  }

  .author-card-heading h3 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
  }

  .author-card-name-link {
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
  }

  .author-card-pronouns,
  .author-card-bio {
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .author-card-bio {
    margin: 0;
  }

  .author-card-bio-compact {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global(.author-card-profile-links) {
    position: relative;
    z-index: 30;
  }
</style>
