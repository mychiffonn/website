---
---

<div id="main-header" class="menu-bar">
  <slot />
  <div class="menu-bar-progress" aria-hidden="true">
    <span data-scroll-progress></span>
  </div>
</div>

<script>
  let fill: HTMLElement | null = null
  let frame = 0

  function update() {
    frame = 0
    if (!fill) return

    const { scrollHeight, clientHeight } = document.documentElement
    const range = scrollHeight - clientHeight
    const progress = range > 0 ? Math.min(1, Math.max(0, scrollY / range)) : 0
    fill.style.scale = `${progress} 1`
  }

  function schedule() {
    // Coalesce the scroll burst into one write per frame.
    if (!frame) frame = requestAnimationFrame(update)
  }

  function bind() {
    fill = document.querySelector<HTMLElement>("[data-scroll-progress]")
    update()
  }

  addEventListener("scroll", schedule, { passive: true })
  addEventListener("resize", schedule, { passive: true })
  document.addEventListener("astro:page-load", bind)
  document.addEventListener("astro:after-swap", bind)
  bind()
</script>

<style>
  .menu-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    isolation: isolate;
    margin-inline: calc(-1 * var(--grid-gutter));
    padding-inline: var(--grid-gutter);
  }

  .menu-bar::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    z-index: -1;
    inline-size: 100vw;
    border-block-end: 1px solid var(--border);
    background: color-mix(in oklab, var(--background) 86%, transparent);
    backdrop-filter: blur(10px);

    pointer-events: none;
    transform: translateX(-50%);
  }

  /* Sits on the border the ::before draws, bleeding to the same 100vw edge. */
  .menu-bar-progress {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 50%;
    inline-size: 100vw;
    block-size: 0.125rem;
    overflow: hidden;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .menu-bar-progress span {
    display: block;
    block-size: 100%;
    background: var(--primary);

    scale: 0 1;
    transform-origin: left center;
  }
</style>
