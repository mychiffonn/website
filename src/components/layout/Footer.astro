---
import { FOOTER, PROFILE, SITE } from "@site-config"
import Icon from "@/components/base/Icon.astro"
import Link from "@/components/base/Link.astro"
import ProfileLinks from "@/components/profile/ProfileLinks.astro"
import { getProfileLinkPlacement } from "@/components/profile/helper"

const footerLinks = getProfileLinkPlacement("footer")

const sourceLinks = [
  FOOTER.sourceCode ? { href: FOOTER.sourceCode, label: "Source Code" } : null,
  FOOTER.sourceContent
    ? { href: FOOTER.sourceContent, label: "Source Content" }
    : null,
  ...FOOTER.footerLinks,
].filter(Boolean) as { href: string; label: string }[]
---

<footer>
  <div class="footer-inner">
    <ProfileLinks links={PROFILE.links} keys={footerLinks} />

    <p>
      &copy; <span id="current-year"></span>
      {PROFILE.name}.
      {SITE.license ? (
          <>
            {` Unless otherwise stated, all content is licensed under `}
            <Link class="footer-link" href={SITE.license.href} external>
              {SITE.license.label}.
            </Link>
          </>
        ) : (
          ` All rights reserved.`
        )}
    </p>

    <p
      class="footer-location"
      data-locale={SITE.locale.lang}
      data-time-zone={SITE.locale.options.timeZone || "UTC"}
    >
      {PROFILE.location && (
          <>
            <Icon name="mingcute:location-line" />
            <span>{PROFILE.location}</span>
            <span class="footer-separator" aria-hidden="true">·</span>
          </>
        )}
      <span class="footer-time">
        <Icon name="time" />
        <time id="current-time"></time>
        <span id="current-time-zone"></span>
      </span>
    </p>

    {sourceLinks.length > 0 && (
        <p class="footer-small">
          {sourceLinks.map((link, index) => [
            <Link href={link.href} class="footer-muted-link" external underline>
              {link.label}
            </Link>,
            index < sourceLinks.length - 1 && " / ",
          ])}
        </p>
      )}

    {FOOTER.credits && (
        <p>
          Built with{" "}
          <Link href="https://astro.build/" class="footer-link" external>
            Astro.
          </Link>
          View
          <Link href="/palette" class="footer-link">
            Color Palette.
          </Link>
        </p>
      )}
  </div>
</footer>

<script>
  const yearElement = document.getElementById("current-year")
  if (yearElement) yearElement.textContent = new Date().getFullYear().toString()

  const timeContainer = document.querySelector<HTMLElement>("[data-time-zone]")
  const timeElement = document.getElementById(
    "current-time",
  ) as HTMLTimeElement | null
  const timeZoneElement = document.getElementById("current-time-zone")

  if (timeContainer && timeElement && timeZoneElement) {
    const locale = timeContainer.dataset.locale || "en-US"
    const timeZone = timeContainer.dataset.timeZone || "UTC"
    const timeFormatter = new Intl.DateTimeFormat(locale, {
      hour: "numeric",
      minute: "2-digit",
      timeZone,
    })
    const timeZoneFormatter = new Intl.DateTimeFormat(locale, {
      timeZone,
      timeZoneName: "short",
    })

    const updateTime = () => {
      const now = new Date()
      timeElement.textContent = timeFormatter.format(now)
      timeElement.dateTime = now.toISOString()
      timeZoneElement.textContent = ` ${
        timeZoneFormatter
          .formatToParts(now)
          .find(({ type }) => type === "timeZoneName")?.value ?? timeZone
      }`
    }

    updateTime()
    window.setInterval(updateTime, 60_000)
  }
</script>

<style>
  footer {
    position: relative;
    margin-block-start: var(--space-l);
    padding-block: var(--space-s);
    border-block-start: 1px solid
      color-mix(in oklab, var(--foreground) 20%, transparent);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .footer-small {
    font-size: var(--step--1);
  }

  .footer-location {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .footer-time {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .footer-link {
    color: var(--foreground);
  }

  .footer-muted-link {
    color: var(--muted-foreground);
  }
</style>
