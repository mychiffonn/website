---
import ToolComponent, { type Props as Tool } from "./Tool.astro"
import CardGroup from "@/components/base/card/CardGroup.astro"

interface Props {
  title: string
  tools: Tool[]
  class?: string
}

const { class: className, title, tools, ...props } = Astro.props
---

<section class:list={["tool-section", className]} {...props}>
  <h2>{title}</h2>
  <CardGroup columns={2} class="tool-grid">
    {tools.map((tool) => <ToolComponent {...tool} />)}
  </CardGroup>
</section>

<style>
  .tool-section {
    display: flex;
    flex-direction: column;
    padding-inline: var(--space-2xs);
  }

  h2 {
    margin: var(--space-2xs);
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xs);
  }

  @media (width >= 40rem) {
    .tool-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
