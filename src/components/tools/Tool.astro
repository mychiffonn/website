---
import Badge from "@/components/base/Badge.astro"
import Icon from "@/components/base/Icon.astro"

import { getTagVariant, ToolTag } from "./tags"

export interface Props {
  name: string
  description: string
  href: string
  icon: string
  tags?: ToolTag[]
}

const { name, description, href, icon, tags } = Astro.props

const getSafeIcon = (icon: string): string => {
  return icon && icon.trim() !== "" ? icon : "mingcute:box-line"
}

const safeIcon = getSafeIcon(icon)
---

<a
  class="tool-link"
  href={href}
  target="_blank"
  rel="noopener noreferrer nofollow"
  aria-label={`${name}: ${description}`}
>
  <Icon name={safeIcon} size="2rem" aria-hidden="true" />
  <div class="tool-body">
    <div class="tool-heading">
      <span class="tool-name">{name}</span>
      {tags?.map((tag: ToolTag) => (
          <Badge variant={getTagVariant(tag)} class="tool-tag">
            {tag}
          </Badge>
        ))}
    </div>
    <p>{description}</p>
  </div>
</a>

<style>
  .tool-link {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    color: inherit;
    font-size: var(--step--1);
    text-decoration: none;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease);
  }

  .tool-link:hover {
    border-color: var(--border);
    background: var(--muted);
  }

  .tool-body {
    min-inline-size: 0;
    flex: 1;
  }

  .tool-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: 0.25rem;
  }

  .tool-name {
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
  }

  .tool-tag {
    font-size: var(--step--1);
  }

  p {
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }
</style>
