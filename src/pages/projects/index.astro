---
import { PROFILE } from "@site-config"
import { getProjectCategoryCounts, getProjects } from "@/lib/projects"
import CommonLayout from "@/layouts/CommonLayout.astro"
import Chip from "@/components/base/Chip.astro"
import Icon from "@/components/base/Icon.astro"
import Section from "@/components/layout/Section.astro"
import { GithubActivity, ProjectCard } from "@/components/projects"

import "@/styles/chip-filter.css"

// Fetch and categorize projects in single operation
const allProjects = await getProjects()
const featuredProjects = allProjects.filter((project) => project.data.isHighlighted)
const otherProjects = allProjects.filter((project) => !project.data.isHighlighted)
const categoryCounts = getProjectCategoryCounts(allProjects)

// Get GitHub URL for GithubActivity
const githubUrl =
  (typeof PROFILE.links.github === "object" ? PROFILE.links.github?.href : PROFILE.links.github) ||
  "https://github.com"
---

<CommonLayout
  title="Projects"
  description="A collection of projects I've worked on, ranging from academic research to personal explorations. If you think it would be useful or interesting to collaborate on a project, please contact me to discuss."
  prose={false}
  breadcrumbs={[{ label: "Projects", icon: "folder-open" }]}
>
  <div class="flex flex-col gap-8">
    {/* Category filter bar */}
    {
      categoryCounts.length > 0 && (
        <div class="chip-filter-bar">
          {categoryCounts.map(({ slug, label, count }) => (
            <Chip data-project-category-filter={slug} aria-pressed="false">
              {label}
              <span class="ml-0.5 opacity-60">({count})</span>
            </Chip>
          ))}
          <span class="chip-active-filter hidden" data-active-filter>
            <button class="chip-clear-filter" data-clear-filter aria-label="Clear filter">
              <Icon name="close" size={12} />
              Clear
            </button>
          </span>
        </div>
      )
    }

    {/* Featured Projects */}
    {
      featuredProjects.length > 0 && (
        <div data-project-section>
          <Section title="Featured Projects">
            <div class="grid gap-4 md:grid-cols-1 lg:grid-cols-2">
              {featuredProjects.map((project) => (
                <ProjectCard {project} />
              ))}
            </div>
          </Section>
        </div>
      )
    }

    {/* Other Projects */}
    {
      otherProjects.length > 0 && (
        <section data-project-section>
          <h2 class="mb-4 text-2xl font-semibold">Other Projects</h2>
          <div class="grid gap-4 md:grid-cols-1 lg:grid-cols-2">
            {otherProjects.map((project) => (
              <ProjectCard {project} />
            ))}
          </div>
        </section>
      )
    }

    {/* GitHub Activity */}
    <GithubActivity githubUrl={githubUrl} />
  </div>
</CommonLayout>

<script>
  import { initChipFilter } from "@/lib/chip-filter"

  function initProjectControls() {
    // astro:page-load and astro:after-swap both fire per navigation; skip the
    // second call so we don't double-bind listeners on this DOM instance.
    // Anchor the flag to a swapped-in element (not document.body, which
    // persists across navigations) so it resets on the next real navigation.
    const anchor = document.querySelector<HTMLElement>("[data-project-section]")
    if (anchor?.dataset.controlsInitialized === "true") return
    if (anchor) anchor.dataset.controlsInitialized = "true"

    initChipFilter({
      itemSelector: "[data-project-categories]",
      itemAttr: "projectCategories",
      filterButtonSelector: "[data-project-category-filter]",
      filterButtonAttr: "projectCategoryFilter",
      chipSelector: "[data-project-category]",
      chipAttr: "projectCategory",
      groupSelector: "[data-project-section]",
      clearButtonSelector: "[data-clear-filter]",
      activeIndicatorSelector: "[data-active-filter]"
    })
  }

  document.addEventListener("astro:page-load", initProjectControls)
  document.addEventListener("astro:after-swap", initProjectControls)
</script>
