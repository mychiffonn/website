---
import { FOOTER, PROFILE } from "@site-config"
import techStack from "@/content/tech-stack.json"
import {
  getProjectSkillCounts,
  getProjectTypeCounts,
  getProjects,
} from "@/lib/projects"
import CommonLayout from "@/layouts/CommonLayout.astro"
import Icon from "@/components/base/Icon.astro"
import TaxonomyChip from "@/components/base/TaxonomyChip.astro"
import { CardGroup } from "@/components/base/card"
import Section from "@/components/layout/Section.astro"
import {
  GithubActivity,
  GithubCard,
  ProjectCard,
  TechStack,
} from "@/components/projects"

import "@/styles/chip-filter.css"

// Fetch and categorize projects in single operation
const allProjects = await getProjects()
const featuredProjects = allProjects.filter(
  (project) => project.data.isHighlighted,
)
const otherProjects = allProjects.filter(
  (project) => !project.data.isHighlighted,
)
const typeCounts = getProjectTypeCounts(allProjects)
const skillCounts = getProjectSkillCounts(allProjects)

const githubRepo = FOOTER.sourceCode
const githubProfile =
  typeof PROFILE.links.github === "object"
    ? PROFILE.links.github?.href
    : PROFILE.links.github
const githubUsername = githubProfile?.replace(/\/$/, "").split("/").pop()
---

<CommonLayout
  title="Projects"
  description="A collection of projects I've worked on, ranging from academic research to personal explorations. If you think it would be useful or interesting to collaborate on a project, please contact me to discuss."
  prose={false}
  breadcrumbs={[{ label: "Projects", icon: "folder-open" }]}
>
  <div class="projects-page">
    <div class="projects-featured">
      {(typeCounts.length > 0 || skillCounts.length > 0) && (
          <div class="project-filters" role="group" aria-label="Project filters">
            {typeCounts.length > 0 && (
              <div
                class="project-filter-row"
                role="group"
                aria-labelledby="project-type-filter-label"
              >
                <span class="project-filter-label" id="project-type-filter-label">
                  Type
                </span>
                <div class="chip-filter-bar">
                  {typeCounts.map(({ slug, label, count }) => (
                    <TaxonomyChip
                      label={label}
                      count={count}
                      countNoun="projects"
                      data-project-type-filter={slug}
                      aria-pressed="false"
                      aria-label={`Filter projects by type ${label}; ${count} ${count === 1 ? "project" : "projects"}`}
                    />
                  ))}
                </div>
              </div>
            )}
            {skillCounts.length > 0 && (
              <div
                class="project-filter-row"
                role="group"
                aria-labelledby="project-skill-filter-label"
              >
                <span class="project-filter-label" id="project-skill-filter-label">
                  Skill
                </span>
                <div class="chip-filter-bar">
                  {skillCounts.map(({ slug, label, count }) => (
                    <TaxonomyChip
                      label={label}
                      count={count}
                      countNoun="projects"
                      data-project-skill-filter={slug}
                      aria-pressed="false"
                      aria-label={`Filter projects by skill ${label}; ${count} ${count === 1 ? "project" : "projects"}`}
                    />
                  ))}
                </div>
              </div>
            )}
            <span class="chip-active-filter" data-active-filter hidden>
              <TaxonomyChip
                label="Clear filters"
                prefix="×"
                tone="destructive"
                data-clear-project-filters
                aria-label="Clear project filters"
              />
            </span>
            <span
              class="sr-only"
              aria-live="polite"
              aria-atomic="true"
              data-project-filter-status
            />
          </div>
        )}
      <div class="project-filter-empty" data-project-filter-empty hidden>
        <h2>No matching projects</h2>
        <p>Try clearing either the project type or skill filter.</p>
      </div>
      {featuredProjects.length > 0 && (
          <div data-project-section>
            <Section title="Featured Projects">
              <CardGroup columns={2} class="project-grid">
                {featuredProjects.map((project) => (
                  <ProjectCard {project} />
                ))}
              </CardGroup>
            </Section>
          </div>
        )}
    </div>
    {otherProjects.length > 0 && (
        <details class="other-projects" data-project-section>
          <summary>
            <span class="other-projects-title" role="heading" aria-level="2">
              Other Projects
            </span>
            <span class="other-projects-toggle">
              <span data-disclosure-show>Show {otherProjects.length} projects</span>
              <span data-disclosure-hide>
                Hide {otherProjects.length} projects
              </span>
              <Icon name="chevron-down" class="other-projects-chevron" />
            </span>
          </summary>
          <CardGroup columns={2} class="project-grid other-projects-grid">
            {otherProjects.map((project) => (
              <ProjectCard {project} />
            ))}
          </CardGroup>
        </details>
      )}
    <Section title="Tech Stack" class="tech-stack-section">
      <TechStack {...techStack} />
    </Section>
    {githubRepo && (
        <Section title="On GitHub" class="github-showcase">
          <GithubCard repo={githubRepo} contributor={githubUsername} />
        </Section>
      )}
    {githubProfile && <GithubActivity githubUrl={githubProfile} />}
  </div>
</CommonLayout>

<script>
  import { initFacetedChipFilter } from "@/lib/chip-filter"

  function initProjectControls() {
    // astro:page-load and astro:after-swap both fire per navigation; skip the
    // second call so we don't double-bind listeners on this DOM instance.
    // Anchor the flag to a swapped-in element (not document.body, which
    // persists across navigations) so it resets on the next real navigation.
    const anchor = document.querySelector<HTMLElement>(".projects-page")
    if (!anchor || anchor.dataset.controlsInitialized === "true") return
    anchor.dataset.controlsInitialized = "true"

    const controller = initFacetedChipFilter({
      itemSelector: "[data-project-types]",
      facets: [
        {
          key: "type",
          itemAttr: "projectTypes",
          filterButtonSelector: "[data-project-type-filter]",
          filterButtonAttr: "projectTypeFilter",
        },
        {
          key: "skill",
          itemAttr: "projectSkills",
          filterButtonSelector: "[data-project-skill-filter]",
          filterButtonAttr: "projectSkillFilter",
        },
      ],
      groupSelector: "[data-project-section]",
      clearButtonSelector: "[data-clear-project-filters]",
      activeIndicatorSelector: "[data-active-filter]",
      statusSelector: "[data-project-filter-status]",
      emptyStateSelector: "[data-project-filter-empty]",
      resultNoun: "projects",
    })

    const otherProjects =
      document.querySelector<HTMLDetailsElement>(".other-projects")
    const disclosureShow = otherProjects?.querySelector<HTMLElement>(
      "[data-disclosure-show]",
    )
    const disclosureHide = otherProjects?.querySelector<HTMLElement>(
      "[data-disclosure-hide]",
    )

    function updateOtherProjectCount() {
      if (!otherProjects) return
      const visibleCount = [
        ...otherProjects.querySelectorAll<HTMLElement>("[data-project-types]"),
      ].filter((project) => project.style.display !== "none").length
      const noun = visibleCount === 1 ? "project" : "projects"
      if (disclosureShow)
        disclosureShow.textContent = `Show ${visibleCount} ${noun}`
      if (disclosureHide)
        disclosureHide.textContent = `Hide ${visibleCount} ${noun}`
    }

    updateOtherProjectCount()
    let openedForFilter = false
    otherProjects?.querySelector("summary")?.addEventListener("click", () => {
      openedForFilter = false
    })
    anchor.addEventListener("click", (event) => {
      const filterTrigger = (event.target as Element).closest(
        "[data-project-type-filter], [data-project-skill-filter], [data-clear-project-filters]",
      )
      if (!filterTrigger) return
      requestAnimationFrame(() => {
        if (!otherProjects) return
        updateOtherProjectCount()
        if (controller.hasActive() && !otherProjects.open) {
          otherProjects.open = true
          openedForFilter = true
        } else if (!controller.hasActive() && openedForFilter) {
          otherProjects.open = false
          openedForFilter = false
        }
      })
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectControls, {
      once: true,
    })
  } else {
    initProjectControls()
  }
  document.addEventListener("astro:page-load", initProjectControls)
  document.addEventListener("astro:after-swap", initProjectControls)
</script>

<style>
  .projects-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .projects-featured {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .project-filters,
  .project-filter-row {
    display: flex;
  }

  .project-filters {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
  }

  .project-filter-row {
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .project-filter-label {
    display: flex;
    align-items: center;
    min-inline-size: 2.75rem;
    min-block-size: calc(var(--control-size-compact) + 2 * var(--space-3xs));
    color: var(--muted-foreground);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
  }

  .project-filter-row .chip-filter-bar {
    gap: var(--space-3xs);
  }

  .chip-active-filter[hidden] {
    display: none;
  }

  .project-filter-empty {
    padding: var(--space-l);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--muted) 34%, transparent);
    text-align: center;
  }

  .project-filter-empty[hidden] {
    display: none;
  }

  .project-filter-empty h2,
  .project-filter-empty p {
    margin: 0;
  }

  .project-filter-empty h2 {
    font-size: var(--step-1);
  }

  .project-filter-empty p {
    margin-block-start: var(--space-3xs);
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .projects-featured :global(.section-block) {
    margin-block-start: 0;
  }

  .other-projects {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--muted) 24%, transparent);
  }

  .other-projects summary,
  .other-projects-toggle {
    display: flex;
    align-items: center;
  }

  .other-projects summary {
    justify-content: space-between;
    gap: var(--space-s);
    min-block-size: var(--control-size);
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-lg);
    cursor: pointer;
    list-style: none;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration-fast) var(--motion-ease);
  }

  .other-projects summary::-webkit-details-marker {
    display: none;
  }

  .other-projects-title {
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
  }

  .other-projects-toggle {
    flex: none;
    gap: var(--space-2xs);
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  [data-disclosure-hide] {
    display: none;
  }

  .other-projects[open] [data-disclosure-show] {
    display: none;
  }

  .other-projects[open] [data-disclosure-hide] {
    display: inline;
  }

  :global(.other-projects-chevron) {
    transition: rotate var(--motion-duration) var(--motion-ease);
  }

  .other-projects[open] :global(.other-projects-chevron) {
    rotate: 180deg;
  }

  .other-projects-grid {
    padding: 0 var(--space-s) var(--space-s);
  }

  @media (hover: hover) and (pointer: fine) {
    .other-projects summary:hover {
      background: color-mix(in oklab, var(--primary) 10%, transparent);
      color: var(--primary);
    }
  }

  @media (width < 40rem) {
    .project-filter-row {
      flex-direction: column;
      gap: var(--space-3xs);
    }

    .project-filter-label {
      min-inline-size: 0;
      min-block-size: 0;
    }

    .other-projects-grid {
      padding: 0 var(--space-xs) var(--space-xs);
    }
  }

  :global(.project-grid[data-columns="2"]) {
    grid-template-columns: 1fr;

    @media (width >= 64rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
