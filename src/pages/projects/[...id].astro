---
import "@/styles/callout.css"
import "@/styles/sidenote.css"

import { render, type CollectionEntry } from "astro:content"

import {
  getProjectLinks,
  getProjectNavigation,
  getProjectTypeLabel,
  getProjects,
} from "@/lib/projects"
import Layout from "@/layouts/Layout.astro"
import Badge from "@/components/base/Badge.astro"
import Button from "@/components/base/Button.astro"
import CopyMarkdown from "@/components/base/CopyMarkdown.astro"
import Icon from "@/components/base/Icon.astro"
import DateRange from "@/components/projects/DateRange.astro"
import ProjectNavigation from "@/components/projects/ProjectNavigation.astro"

export async function getStaticPaths() {
  const projects = await getProjects((project) => !!project.body?.trim())

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }))
}

type Props = {
  project: CollectionEntry<"projects">
}

const { project } = Astro.props
const [{ Content }, navigation] = await Promise.all([
  render(project),
  getProjectNavigation(project.id),
])
const {
  title,
  isHighlighted,
  fromDate,
  toDate,
  code,
  doc,
  paper,
  url,
  release,
  types,
  skills,
  tags,
} = project.data

const links = getProjectLinks(code, doc, paper, url, release)
const rawMarkdown = project.body ?? null
---

<Layout
  title={title}
  description={`Project: ${title}`}
  breadcrumbs={[
    { href: "/projects", label: "Projects", icon: "folder-open" },
    { label: title, icon: "file" },
  ]}
>
  <header class="project-header">
    <div class="project-title-row">
      <h1>{title}</h1>
      {isHighlighted && (
          <Badge variant="default" class="featured-badge">
            <Icon name="star" class="featured-badge-icon" />
            Featured
          </Badge>
        )}
    </div>
    <div class="project-meta-row">
      {types.map((slug) => (
        <Badge variant="muted">{getProjectTypeLabel(slug)}</Badge>
      ))}
      <DateRange
        fromDate={fromDate}
        toDate={toDate}
        class="project-date-range"
        showIcon={true}
      />
    </div>
    {(skills.length > 0 || tags.length > 0) && (
        <div class="project-tags">
          {skills.map((skill) => (
            <Badge variant="accent" class="project-tag">
              {skill}
            </Badge>
          ))}
          {tags.map((tag) => (
            <Badge variant="muted" class="project-tag">
              {tag}
            </Badge>
          ))}
        </div>
      )}
    {links.length > 0 && (
        <div class="project-links">
          {links.map(({ href, icon, label }) => (
            <Button href={href} variant="accent-outline">
              <Icon name={icon} />
              <span>{label}</span>
            </Button>
          ))}
        </div>
      )}
  </header>

  <article>
    <prose-content>
      <Content />
    </prose-content>
  </article>

  {rawMarkdown && <CopyMarkdown markdown={rawMarkdown} class="copy-project-markdown" />}

  <ProjectNavigation prev={navigation.prev} next={navigation.next} />
</Layout>

<style>
  .project-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-block-end: var(--space-xl);
  }

  .project-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .project-title-row h1 {
    margin: 0;
    font-size: var(--step-3);
    line-height: var(--line-height-tight);
    font-weight: var(--font-weight-bold);
    text-wrap: balance;
  }

  @media (width >= 40rem) {
    .project-title-row h1 {
      font-size: var(--step-4);
    }
  }

  :global(.featured-badge) {
    flex-shrink: 0;
  }

  :global(.featured-badge-icon) {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    margin-inline-end: var(--space-3xs);
  }

  .project-meta-row,
  .project-tags,
  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .project-meta-row {
    font-size: var(--step--1);
  }

  :global(.project-date-range) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    color: var(--muted-foreground);
  }

  :global(.project-tag) {
    font-size: var(--step--1);
  }

  :global(.copy-project-markdown) {
    display: flex;
    justify-content: flex-end;
    margin-block: var(--space-l);
  }
</style>
