---
import "@/styles/callout.css"
import "@/styles/sidenote.css"

import { render, type CollectionEntry } from "astro:content"

import { SITE } from "@site-config"
import {
  getProjectLinks,
  getProjectNavigation,
  getProjectTypeLabel,
  getProjects,
} from "@/lib/projects"
import { processRawHeadings } from "@/lib/toc"
import type { TOCSection } from "@/lib/toc"
import { buildMarkdownDocument } from "@/lib/markdown-document"
import Layout from "@/layouts/Layout.astro"
import Badge from "@/components/base/Badge.astro"
import Button from "@/components/base/Button.astro"
import CopyMarkdown from "@/components/base/CopyMarkdown.astro"
import Icon from "@/components/base/Icon.astro"
import SlideOut from "@/components/layout/SlideOut.astro"
import DateRange from "@/components/projects/DateRange.astro"
import ProjectNavigation from "@/components/projects/ProjectNavigation.astro"
import TOCFloat from "@/components/toc/TOCFloat.astro"
import TOCHeader from "@/components/toc/TOCHeader.astro"
import TOCSidebar from "@/components/toc/TOCSidebar.astro"

export async function getStaticPaths() {
  const projects = await getProjects((project) => !!project.body?.trim())

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }))
}

type Props = {
  project: CollectionEntry<"projects">
}

const { project } = Astro.props
const [{ Content, headings: rawHeadings }, navigation] = await Promise.all([
  render(project),
  getProjectNavigation(project.id),
])
const headings = processRawHeadings(rawHeadings, SITE.tocMaxDepth)
const tocSections: TOCSection[] =
  headings.length > 0
    ? [
        {
          postId: project.id,
          postTitle: project.data.title,
          isSubpost: false,
          headings,
        },
      ]
    : []
const {
  title,
  selected,
  fromDate,
  toDate,
  code,
  doc,
  paper,
  url,
  release,
  types,
  skills,
} = project.data

const links = getProjectLinks(code, doc, paper, url, release)
const rawMarkdown = project.body
  ? buildMarkdownDocument(project.body, {
      title,
      description: project.data.description,
      path: `/projects/${project.id}`,
      date: toDate ?? fromDate,
    })
  : null
---

<Layout
  title={title}
  description={`Project: ${title}`}
  breadcrumbs={[
    { href: "/projects", label: "Projects", icon: "folder-open" },
    { label: title, icon: "file" },
  ]}
>
  {headings.length > 1 && <TOCHeader slot="toc-header" headings={headings} />}
  <header class="project-header">
    <div class="project-title-row">
      <h1>{title}</h1>
      {selected && (
          <Badge variant="default" class="featured-badge">
            <Icon name="star" class="featured-badge-icon" />
            Featured
          </Badge>
        )}
    </div>
    <div class="project-meta-row">
      <DateRange
        fromDate={fromDate}
        toDate={toDate}
        class="project-date-range"
        showIcon={true}
      />
      {types.map((slug) => <Badge variant="muted">{getProjectTypeLabel(slug)}</Badge>)}
    </div>
    {skills.length > 0 && (
        <div class="project-skills">
          {skills.map((skill) => (
            <Badge variant="accent" class="project-skill">
              {skill}
            </Badge>
          ))}
        </div>
      )}
    {links.length > 0 && (
        <div class="project-links">
          {links.map(({ href, icon, label }) => (
            <Button href={href} variant="accent-outline">
              <Icon name={icon} />
              <span>{label}</span>
            </Button>
          ))}
        </div>
      )}
  </header>

  <SlideOut position="left">
    {tocSections.length > 0 && (
        <TOCSidebar slot="main" sections={tocSections} currentPostId={project.id} />
      )}
    {headings.length > 0 && <TOCFloat slot="summary" headings={headings} />}
  </SlideOut>

  <article>
    <prose-content>
      <Content />
    </prose-content>
  </article>

  {rawMarkdown && <CopyMarkdown markdown={rawMarkdown} class="copy-project-markdown" />}

  <ProjectNavigation prev={navigation.prev} next={navigation.next} />
</Layout>

<style>
  .project-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-block-end: var(--space-xl);
  }

  .project-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .project-title-row h1 {
    margin: 0;
    font-size: var(--step-3);
    line-height: var(--line-height-tight);
    font-weight: var(--font-weight-bold);
    text-wrap: balance;
  }

  @media (width >= 40rem) {
    .project-title-row h1 {
      font-size: var(--step-4);
    }
  }

  :global(.featured-badge) {
    flex-shrink: 0;
  }

  :global(.featured-badge-icon) {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    margin-inline-end: var(--space-3xs);
  }

  .project-meta-row,
  .project-skills,
  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .project-meta-row {
    font-size: var(--step--1);
  }

  :global(.project-date-range) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    color: var(--muted-foreground);
  }

  :global(.project-skill) {
    font-size: var(--step--1);
  }

  :global(.copy-project-markdown) {
    display: flex;
    justify-content: flex-end;
    margin-block: var(--space-l);
  }
</style>
