---
import { PostManager } from "@/lib/blog"
import { getAllAuthors, getAuthorById } from "@/lib/blog/author"
import Layout from "@/layouts/Layout.astro"
import PreviewCard from "@/components/blog/PreviewCard.astro"
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro"
import AuthorCard from "@/components/people/AuthorCard.astro"

export async function getStaticPaths() {
  const authors = await getAllAuthors()

  return authors.map((author) => ({
    params: { id: author.id },
    props: { authorId: author.id },
  }))
}

const { authorId } = Astro.props

const postManager = PostManager.getInstance()
const [author, authorPostsMetadata] = await Promise.all([
  getAuthorById(authorId),
  postManager.getPostsByAuthor(authorId),
])

if (!author) {
  return Astro.redirect("/404")
}
---

<Layout
  title={`${author.name}`}
  description={author.bio || `Profile of ${author.name}.`}
  noindex
  type="profile"
>
  <Breadcrumbs
    slot="breadcrumb"
    items={[
      { href: "/people", label: "People", icon: "group" },
      { label: author.name, icon: "person" }
    ]}
  />

  <section>
    <AuthorCard author={author} />
  </section>
  <section class="author-posts">
    <h2>Posts by {author.name}</h2>
    {authorPostsMetadata.length > 0 ? (
        <ul>
          {authorPostsMetadata.map((metadata) => (
            <li>
              <PreviewCard metadata={metadata} />
            </li>
          ))}
        </ul>
      ) : (
        <p>No posts available from this author.</p>
      )}
  </section>
</Layout>

<style>
  .author-posts {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .author-posts h2 {
    margin: 0;
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
  }

  .author-posts ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .author-posts p {
    color: var(--muted-foreground);
  }
</style>
