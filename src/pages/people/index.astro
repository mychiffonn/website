---
import { getAllAuthors } from "@/lib/blog/author"
import Layout from "@/layouts/Layout.astro"
import AuthorCard from "@/components/people/AuthorCard.astro"

const authors = await getAllAuthors()
---

<Layout title="People" breadcrumbs={[{ label: "People", icon: "group" }]}>
  {authors.length > 0 ? (
      <ul class="people-list">
        {authors.map((author) => (
          <li>
            <AuthorCard author={author} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="people-empty">No authors found.</p>
    )}
</Layout>

<style>
  .people-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .people-empty {
    color: var(--muted-foreground);
    text-align: center;
  }
</style>
