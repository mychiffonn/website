---
import CommonLayout from "@/layouts/CommonLayout.astro"
import CopyButton from "@/components/base/CopyButton.astro"

const colorGroups = [
  {
    label: "Core",
    tokens: ["background", "foreground"],
  },
  {
    label: "Brand",
    tokens: ["primary", "primary-foreground", "accent", "accent-foreground"],
  },
  {
    label: "UI",
    tokens: ["muted", "muted-foreground", "border", "ring", "destructive"],
  },
]
---

<CommonLayout
  title="Colors Palette"
  description="Palette with live previews, computed by theme."
  breadcrumbs={[{ label: "Palette", icon: "mingcute:palette-line" }]}
  prose={false}
>
  {colorGroups.map((group) => (
      <section class="palette-section">
        <h2>{group.label}</h2>
        <div class="palette-grid">
          {group.tokens.map((token) => (
            <div class="palette-card" data-palette-card={token}>
              <div class="palette-swatch" style={`background-color:var(--${token})`}>
                <div class="palette-overlay">
                  <span data-overlay={token}>
                    {token}
                  </span>
                </div>
              </div>
              <div class="palette-card-body">
                <p>{token}</p>
                <div class="palette-value-row">
                  <code class="oklch-value" data-value={token}>
                    …
                  </code>
                  <CopyButton
                    selector=".oklch-value"
                    title={`Copy ${token} OKLCH value`}
                    size="1rem"
                    class="palette-copy"
                  />
                </div>
                <div class="palette-value-row">
                  <code class="hex-value" data-hex={token}>
                    …
                  </code>
                  <CopyButton
                    selector=".hex-value"
                    title={`Copy ${token} hex value`}
                    size="1rem"
                    class="palette-copy"
                  />
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
</CommonLayout>

<style>
  .palette-section {
    margin-block-end: var(--space-xl);
  }

  .palette-section h2 {
    margin-block: 0 var(--space-xs);
    color: var(--foreground);
    font-size: var(--step-2);
    font-weight: var(--font-weight-semibold);
  }

  .palette-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
  }

  .palette-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .palette-swatch {
    position: relative;
    block-size: 8rem;
  }

  .palette-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--motion-duration) var(--motion-ease);
  }

  .palette-card:hover .palette-overlay {
    opacity: 1;
  }

  .palette-overlay span {
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .palette-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-2xs);
  }

  .palette-card-body p {
    margin-block: 0 var(--space-3xs);
    color: var(--foreground);
    font-size: var(--step--1);
    font-weight: var(--font-weight-semibold);
  }

  .palette-value-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3xs);
  }

  .palette-value-row code {
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  :global(.palette-copy) {
    flex-shrink: 0;
    color: var(--muted-foreground);
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }

  :global(.palette-copy:hover) {
    color: var(--foreground);
  }
</style>

<script is:inline data-astro-rerun>
  ;(function () {
    var hexCtx = document.createElement("canvas").getContext("2d")

    function colorToHex(color) {
      if (!color) return ""
      hexCtx.fillStyle = "#000"
      hexCtx.fillStyle = color
      var resolved = hexCtx.fillStyle
      if (resolved.charAt(0) === "#") return resolved
      var m = resolved.match(/[\d.]+/g)
      if (!m || m.length < 3) return ""
      return (
        "#" +
        [m[0], m[1], m[2]]
          .map(function (v) {
            var h = Math.round(Number(v)).toString(16)
            return h.length === 1 ? "0" + h : h
          })
          .join("")
      )
    }

    function isLight(el) {
      var color = getComputedStyle(el).backgroundColor
      hexCtx.fillStyle = "#000"
      hexCtx.fillStyle = color
      var resolved = hexCtx.fillStyle
      var m = resolved.match(/[\d.]+/g)
      if (!m || m.length < 3) {
        var hex = resolved.replace("#", "")
        var r = parseInt(hex.substring(0, 2), 16)
        var g = parseInt(hex.substring(2, 4), 16)
        var b = parseInt(hex.substring(4, 6), 16)
        return r * 0.299 + g * 0.587 + b * 0.114 > 150
      }
      return (
        Number(m[0]) * 0.299 + Number(m[1]) * 0.587 + Number(m[2]) * 0.114 > 150
      )
    }

    function updateColorValues() {
      var style = getComputedStyle(document.documentElement)

      document.querySelectorAll("[data-value]").forEach(function (el) {
        var token = el.getAttribute("data-value")
        var value = style.getPropertyValue("--" + token).trim()
        el.textContent = value || "–"
      })

      document.querySelectorAll("[data-hex]").forEach(function (el) {
        var token = el.getAttribute("data-hex")
        var value = style.getPropertyValue("--" + token).trim()
        el.textContent = value ? colorToHex(value) : "–"
      })

      document.querySelectorAll("[data-overlay]").forEach(function (pill) {
        var card = pill.closest("[data-palette-card]")
        if (!card) return
        var swatchEl = card.querySelector("[style*=background-color]")
        if (!swatchEl) return
        var light = isLight(swatchEl)
        pill.style.backgroundColor = light
          ? "rgba(0,0,0,0.75)"
          : "rgba(255,255,255,0.85)"
        pill.style.color = light ? "#fff" : "#000"
      })
    }

    updateColorValues()
    document.addEventListener("astro:after-swap", updateColorValues)

    new MutationObserver(updateColorValues).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    })
  })()
</script>
