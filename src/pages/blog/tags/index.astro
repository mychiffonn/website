---
import { PostManager } from "@/lib/blog"
import { getSortedTags } from "@/lib/blog/tag"
import Layout from "@/layouts/Layout.astro"
import Badge from "@/components/base/Badge.astro"
import Icon from "@/components/base/Icon.astro"
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro"

const postManager = PostManager.getInstance()
const sortedTags = await getSortedTags(() => postManager.getMainPosts())
---

<Layout title="Tags">
  <Breadcrumbs
    items={[
      { label: "Blog", icon: "blog", href: "/blog" },
      { label: "Tags", icon: "tags", href: "/blog/tags" }
    ]}
  />

  <tag-list>
    <tag-cloud>
      {sortedTags.map(({ tag, count }) => (
          <Badge href={`/blog/tags/${tag}`} variant="tag">
            <Icon name="hashtag" size="0.75rem" />
            {tag}
            <span>({count})</span>
          </Badge>
        ))}
    </tag-cloud>
  </tag-list>
</Layout>

<style>
  tag-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  tag-cloud span {
    margin-inline-start: 0.375rem;
    opacity: 0.7;
  }
</style>
