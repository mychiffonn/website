---
import { PostManager, type PostMeta } from "@/lib/blog"
import { getStageConfig } from "@/lib/blog/stage"
import Layout from "@/layouts/Layout.astro"
import Icon from "@/components/base/Icon.astro"
import PreviewCard from "@/components/blog/PreviewCard.astro"

export async function getStaticPaths() {
  const { STAGE_NAMES } = await import("@/lib/blog/stage")
  return STAGE_NAMES.map((stage) => ({
    params: { stage },
    props: { stage },
  }))
}

const { stage } = Astro.props
const stageConfig = getStageConfig(stage)!
const postManager = PostManager.getInstance()
const allPosts = await postManager.getMainPosts()
const filteredPosts = allPosts.filter((post) => post.data.stage === stage)

const postsMetadata: PostMeta[] = await Promise.all(
  filteredPosts.map((post) => postManager.getMetadata(post.id)),
)
---

<Layout
  title={`${stage} posts`}
  description={`Blog posts at the ${stage} stage of growth.`}
  noindex
  breadcrumbs={[
    { href: "/blog", label: "Blog", icon: "blog" },
    { href: "/blog/stages", label: "Stages", icon: "seedling" },
    { label: stage, icon: stage },
  ]}
>
  <stage-header>
    <stage-title>
      <Icon name={stage} />
      <h1>{stage} posts</h1>
      <span>({postsMetadata.length})</span>
    </stage-title>
    <p>{stageConfig.description}</p>
  </stage-header>

  {postsMetadata.length === 0 ? (
      <p class="empty-stage">No posts at this stage yet.</p>
    ) : (
      <ul class="post-list">
        {postsMetadata.map((metadata) => (
          <li>
            <PreviewCard metadata={metadata} />
          </li>
        ))}
      </ul>
    )}
</Layout>

<style>
  stage-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-block-end: var(--space-l);
  }

  stage-title {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  stage-title :global(svg) {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  h1 {
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
    text-transform: capitalize;
  }

  stage-title span,
  stage-header p,
  .empty-stage {
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>
