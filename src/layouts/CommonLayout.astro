---
import Layout from "@/layouts/Layout.astro"
import CopyMarkdown from "@/components/base/CopyMarkdown.astro"
import FormattedDate from "@/components/base/FormattedDate.astro"
import type { BreadcrumbItem } from "@/components/layout/Breadcrumbs.astro"

interface Props {
  title: string
  description?: string
  modifiedTime?: Date
  prose?: boolean
  markdown?: string
  breadcrumbs?: BreadcrumbItem[]
  [key: string]: any // Allow any additional props to pass through to Layout
}

const {
  title,
  description,
  modifiedTime,
  prose = true,
  markdown,
  breadcrumbs,
  ...layoutProps
} = Astro.props
---

<Layout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  {...layoutProps}
>
  <section class="page-heading">
    <h1>{title}</h1>
    {description && <p class="page-description">{description}</p>}
    {modifiedTime && <FormattedDate date={modifiedTime} class="page-modified" />}
  </section>

  {prose && markdown && (
      <CopyMarkdown markdown={markdown} class="common-copy-markdown" />
    )}
  {prose ? (
      <prose-content>
        <slot />
      </prose-content>
    ) : (
      <slot />
    )}
</Layout>

<style>
  .page-heading {
    margin-block: var(--space-s);

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      margin-block-end: var(--space-2xs);
    }
  }

  .page-description,
  :global(.page-modified) {
    color: var(--muted-foreground);
  }

  :global(.page-modified) {
    font-size: var(--step--1);
  }

  :global(.common-copy-markdown) {
    display: flex;
    justify-content: flex-end;
    margin-block: var(--space-s);
  }
</style>
