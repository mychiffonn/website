---
import "@/styles/global.css"

import { SITE } from "@site-config"
import BackToTop from "@/components/base/BackToTop.astro"
import Head from "@/components/layout/Head.astro"
import Footer from "@/components/layout/Footer.astro"
import Header from "@/components/layout/Header.astro"
import Breadcrumbs, {
  type BreadcrumbItem,
} from "@/components/layout/Breadcrumbs.astro"

interface Props {
  class?: string
  title?: string
  description?: string
  image?: string | URL
  noindex?: boolean
  type?: "website" | "article" | "profile"
  publishedTime?: Date
  modifiedTime?: Date
  author?: string
  tags?: string[]
  section?: string
  breadcrumbs?: BreadcrumbItem[]
}

const {
  class: className,
  title,
  description,
  image,
  noindex,
  type,
  publishedTime,
  modifiedTime,
  author,
  tags,
  section,
  breadcrumbs,
} = Astro.props
---

<!doctype html>
<html lang={SITE.locale.lang} dir={SITE.dir}>
  <Head
    title={title}
    description={description}
    image={image}
    noindex={noindex}
    type={type}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    author={author}
    tags={tags}
    section={section}
  >
    <slot name="head" />
  </Head>
  <body>
    <div id="main-header">
      <Header />
      {Astro.slots.has("subposts-navigation-header") && (
        <slot name="subposts-navigation-header" aria-label="Post-subposts navigation" />
      )}
      {Astro.slots.has("toc-header") && (
        <slot name="toc-header" aria-label="Table of contents" />
      )}
    </div>
    {(breadcrumbs || Astro.slots.has("breadcrumb")) && (
      <div class="breadcrumb-region">
        {breadcrumbs ? <Breadcrumbs items={breadcrumbs} /> : <slot name="breadcrumb" />}
      </div>
    )}
    <main class={className}>
      <slot />
    </main>
    <BackToTop />
    <Footer />

    <script>
      let headerResizeObserver: ResizeObserver | undefined
      let observedHeader: HTMLElement | null = null

      function updateHeaderHeight() {
        const header = document.getElementById("main-header")
        if (!header) return
        document.documentElement.style.setProperty(
          "--header-height",
          `${header.offsetHeight}px`,
        )
      }

      function observeHeaderHeight() {
        const header = document.getElementById("main-header")
        if (!header) return

        if (header === observedHeader) {
          updateHeaderHeight()
          return
        }

        headerResizeObserver?.disconnect()
        headerResizeObserver = new ResizeObserver(updateHeaderHeight)
        headerResizeObserver.observe(header)
        observedHeader = header
        updateHeaderHeight()
      }

      observeHeaderHeight()
      document.addEventListener("astro:after-swap", observeHeaderHeight)
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    font-family: var(--font-sans);
    overflow-x: clip;
  }

  #main-header {
    position: sticky;
    top: 0;
    z-index: 50;
    margin-inline: calc(-1 * var(--grid-gutter));
    padding-inline: var(--grid-gutter);
    border-block-end: 1px solid var(--border);
    background: color-mix(in oklab, var(--background) 86%, transparent);
    backdrop-filter: blur(10px);
  }

  .breadcrumb-region {
    display: flex;
    width: 100%;
    margin-block: var(--space-s);
  }

  main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-m);
    min-width: 0;
  }

  main > :first-child {
    margin-block-start: var(--space-s);
  }

  @media (width >= 75rem) {
    body {
      overflow-x: visible;
    }
  }
</style>
