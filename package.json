{
  "name": "website-astro",
  "description": "A fast Astro theme for academic personal sites, research blogs, projects, and publications.",
  "type": "module",
  "version": "2.2.5",
  "license": "Apache-2.0",
  "author": "My (Chiffon) Nguyen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mychiffonn/website.git"
  },
  "bugs": {
    "url": "https://github.com/mychiffonn/website/issues"
  },
  "homepage": "https://github.com/mychiffonn/website#readme",
  "keywords": [
    "astro",
    "astro-theme",
    "astro-template",
    "academic",
    "blog",
    "portfolio",
    "publications",
    "research"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "sync": "astro sync",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "oxlint --type-aware",
    "lint:styles": "node scripts/check-style-architecture.mjs",
    "routine": "pnpm lint && pnpm lint:styles && pnpm sync && pnpm format:check",
    "clean": "rm -rf dist/ .astro/ node_modules/.astro/data-store.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-satteri": "^0.3.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@date-fns/tz": "^1.5.0",
    "@expressive-code/plugin-collapsible-sections": "^0.42.0",
    "@expressive-code/plugin-line-numbers": "^0.42.0",
    "@iconify-json/academicons": "^1.2.4",
    "@iconify-json/mingcute": "^1.2.7",
    "@iconify/utils": "^3.1.3",
    "astro": "^7.1.3",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "hast-util-select": "^6.0.4",
    "hast-util-to-html": "^9.0.5",
    "hastscript": "^9.0.1",
    "husky": "^9.1.7",
    "satori": "^0.26.0",
    "satteri": "^0.9.4",
    "satteri-expressive-code": "^0.1.17",
    "temml": "^0.13.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "mdast-util-to-hast": "^13.2.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "sharp": "^0.35.3"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
