# Cloudflare Pages headers: https://developers.cloudflare.com/pages/configuration/headers/
#
# Build output in /_astro is content-hashed by Vite, so it's safe to cache
# forever and skip revalidation entirely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static assets below aren't hashed, so cache long but let the browser
# revalidate on reload instead of marking them immutable.
/fonts/*
  Cache-Control: public, max-age=31536000

/img/*
  Cache-Control: public, max-age=31536000

/favicon.ico
  Cache-Control: public, max-age=31536000

/favicon.svg
  Cache-Control: public, max-age=31536000

/*.png
  Cache-Control: public, max-age=31536000
